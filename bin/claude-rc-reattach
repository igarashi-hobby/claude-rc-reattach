#!/bin/zsh
# claude-rc-reattach — アカウント切り替え後、RC 接続中だった会話を新アカウントで復帰させる
#
# 仕組み:
#   Claude Code は実行中セッションの状態を ~/.claude/sessions/<PID>.json に書き出す。
#   bridgeSessionId フィールドがあるものが Remote Control 接続中のセッション。
#   save でそれを manifest に記録し、restore で `claude --resume <sessionId> --remote-control`
#   を tmux 内に立ち上げ直すことで、新アカウント配下の新しい RC セッションとして再登録する。
#
# 検証環境: Claude Code v2.1.233 / macOS

set -u
set -o pipefail

VERSION="1.7.0"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/claude-rc-reattach"
MANIFEST="${CLAUDE_RC_MANIFEST:-$STATE_DIR/manifest.tsv}"
TMUX_SESSION="${CLAUDE_RC_TMUX_SESSION:-rc-restore}"
SESSIONS_DIR="$HOME/.claude/sessions"
PROJECTS_DIR="$HOME/.claude/projects"
# save が記録するのは「実行中かつ RC 接続中」の会話だけなので、最終チャットが古くても
# 放置された会話とは限らない。既定では日数で捨てず、古い場合に一言添えるだけにする
# （0 = skip しない。1 以上を指定するとその日数を超えた会話を skip する）
MAX_AGE_DAYS="${CLAUDE_RC_MAX_AGE_DAYS:-0}"
VERIFY_TIMEOUT="${CLAUDE_RC_VERIFY_TIMEOUT:-60}"
STAGGER_SECS="${CLAUDE_RC_STAGGER_SECS:-3}"
RECOVER_HOURS="${CLAUDE_RC_RECOVER_HOURS:-6}"
CONFIRM_WAIT="${CLAUDE_RC_CONFIRM_WAIT:-10}"
MAX_SESSIONS="${CLAUDE_RC_MAX_SESSIONS:-15}"
WAVE_SIZE="${CLAUDE_RC_WAVE_SIZE:-3}"
CONFIRM_PENDING=0   # handle_confirm_dialogs の結果（ダイアログ待ちの pane 数）
RESUME_MODE="as-is"
CONFIRM_DIALOG_ENTRIES=()
# wait_rc_registration のループ内から handle_confirm_dialogs を呼ぶときの auto 値。
# trust 系ダイアログ（プロジェクト設定・権限の無確認適用 / managed settings 承認）への
# Enter は「承認」そのものなので、--auto-confirm を明示した recover 以外では 0 のままにする
CONFIRM_AUTO=0
# recap で送るプロンプト。復帰後の RC セッションには切り替え前の履歴が送られない
# （Claude Code のクロスアカウント抑止）ため、要約を 1 通送って文脈をリモートに残す。
# 送信後すぐ Enter を打つので、必ず 1 行で書くこと
RECAP_PROMPT="${CLAUDE_RC_RECAP_PROMPT:-アカウント切替で画面上の履歴が空になっています。これまでの会話の経緯・決定事項・いま取り組んでいる作業を10行以内で要約して表示してください。}"

err()  { print -u2 -- "✖ $*"; }
warn() { print -- "⚠ $*"; }
info() { print -- "  $*"; }
ok()   { print -- "✔ $*"; }

# 数値系の環境変数は不正値なら既定値に戻す
# （非数値のまま (( )) で比較すると zsh が実行時エラーを出し、チェックが素通りするため）
if [[ ! "$MAX_AGE_DAYS" =~ ^[0-9]+$ ]]; then
  warn "CLAUDE_RC_MAX_AGE_DAYS='$MAX_AGE_DAYS' は数値ではないため既定値 0（skip しない）を使います"
  MAX_AGE_DAYS=0
fi
if [[ ! "$VERIFY_TIMEOUT" =~ ^[0-9]+$ ]]; then
  warn "CLAUDE_RC_VERIFY_TIMEOUT='$VERIFY_TIMEOUT' は数値ではないため既定値 60 を使います"
  VERIFY_TIMEOUT=60
fi
if [[ ! "$STAGGER_SECS" =~ ^[0-9]+$ ]]; then
  warn "CLAUDE_RC_STAGGER_SECS='$STAGGER_SECS' は数値ではないため既定値 3 を使います"
  STAGGER_SECS=3
fi
if [[ ! "$RECOVER_HOURS" =~ ^[0-9]+$ ]]; then
  warn "CLAUDE_RC_RECOVER_HOURS='$RECOVER_HOURS' は数値ではないため既定値 6 を使います"
  RECOVER_HOURS=6
fi
if [[ ! "$CONFIRM_WAIT" =~ ^[0-9]+$ ]]; then
  warn "CLAUDE_RC_CONFIRM_WAIT='$CONFIRM_WAIT' は数値ではないため既定値 15 を使います"
  CONFIRM_WAIT=10
fi
if [[ ! "$MAX_SESSIONS" =~ ^[0-9]+$ ]]; then
  warn "CLAUDE_RC_MAX_SESSIONS='$MAX_SESSIONS' は数値ではないため既定値 15 を使います"
  MAX_SESSIONS=15
fi
if [[ ! "$WAVE_SIZE" =~ ^[0-9]+$ ]]; then
  warn "CLAUDE_RC_WAVE_SIZE='$WAVE_SIZE' は数値ではないため既定値 3 を使います"
  WAVE_SIZE=3
fi

# tmux はセッション名の . と : を _ に置き換えて保存するため、そのままだと
# has-session -t "=名前" が毎回失敗し、2 件目以降が duplicate session で落ちる
if [[ "$TMUX_SESSION" == *[.:]* ]]; then
  warn "tmux セッション名 '$TMUX_SESSION' の . と : は使えないため _ に置き換えます"
  TMUX_SESSION="${TMUX_SESSION//[.:]/_}"
fi

need() {
  command -v "$1" >/dev/null 2>&1 || { err "'$1' が見つかりません。インストールしてください"; exit 1; }
}

# tmux が無い場合はインストール方法を案内して失敗させる
#   list / save は tmux 不要のため need() ではなくコマンド側で個別にチェックする。
#   switch は logout 後に気づくと手遅れなので、冒頭でもこれを呼ぶ
need_tmux() {
  command -v tmux >/dev/null 2>&1 && return 0
  err "'tmux' が見つかりません。restore / reconnect / switch には tmux が必要です"
  if [[ "$OSTYPE" == darwin* ]]; then
    info "インストール方法: brew install tmux"
  else
    info "インストール方法: sudo apt install tmux（Debian/Ubuntu）/ sudo dnf install tmux（Fedora）等"
  fi
  return 1
}

# 実行中の interactive セッションを TSV で列挙する
#   mode=rc   → RC 接続中（bridgeSessionId あり）のものだけ
#   mode=open → RC の有無を問わず、生きているものすべて（多重 resume 防止用）
#   同じ sessionId が複数のプロセスに現れた場合は 1 行だけ返す（restore が同じ会話を
#   二重に立ち上げて会話ログへ多重書き込みするのを防ぐため）
scan_sessions() {
  local mode="$1"
  python3 - "$mode" "$SESSIONS_DIR" <<'PY'
import glob, json, os, subprocess, sys
from datetime import datetime, timezone
mode, sessions_dir = sys.argv[1], sys.argv[2]

# --- 実行中プロセスの一覧（PID 再利用の誤検出を避けるため使う） ---
def live_processes():
    """pid -> (開始時刻(UTC, naive) or None, argv 文字列)"""
    out = {}
    try:
        raw = subprocess.run(["ps", "-ax", "-o", "pid=,lstart=,args="],
                             capture_output=True, text=True).stdout
    except Exception:
        return out
    for line in raw.splitlines():
        parts = line.split(None, 6)   # pid + lstart(5語) + args
        if len(parts) < 7:
            continue
        try:
            pid = int(parts[0])
        except ValueError:
            continue
        started = None
        try:
            # ps の lstart はローカル時刻。UTC に直して比較できるようにする
            local = datetime.strptime(" ".join(parts[1:6]), "%a %b %d %H:%M:%S %Y")
            started = local.astimezone().astimezone(timezone.utc).replace(tzinfo=None)
        except Exception:
            pass
        out[pid] = (started, parts[6])
    return out

def same_process(d, pid, procs):
    """状態ファイルの pid が、それを書いたプロセス本人かどうか"""
    if pid not in procs:
        return False
    started, args = procs[pid]
    # procStart は UTC 表記。1 秒以内に収まれば同一プロセスとみなす
    ps_start = d.get("procStart")
    if isinstance(ps_start, str) and started is not None:
        try:
            recorded = datetime.strptime(ps_start.strip(), "%a %b %d %H:%M:%S %Y")
            return abs((recorded - started).total_seconds()) <= 1
        except Exception:
            pass
    # procStart が読めない場合は argv に claude が含まれるかで代用する
    return "claude" in args.lower()


procs = live_processes()
seen = set()
for path in sorted(glob.glob(os.path.join(sessions_dir, "*.json"))):
    try:
        d = json.load(open(path))
    except Exception:
        continue
    if d.get("kind") != "interactive":
        continue
    pid = d.get("pid")
    if not isinstance(pid, int):
        continue
    if not same_process(d, pid, procs):
        continue
    if mode == "rc" and not d.get("bridgeSessionId"):
        continue
    sid, cwd = d.get("sessionId"), d.get("cwd")
    if not sid or not cwd:
        continue
    if sid in seen:
        continue
    seen.add(sid)
    print("\t".join([sid, cwd, (d.get("name") or "").replace("\t", " ").replace("\n", " "), str(pid)]))
PY
}

# いま開かれている会話の sessionId を重複なしで列挙する（同じ会話の二重起動を防ぐため）
#   1) ~/.claude/sessions/*.json（PID が生きているもの）の sessionId
#   2) 実行中プロセスのコマンドライン中の `--resume <sessionId>`
#      → --fork-session で複製した場合、走っている claude 本人の sessionId は別物になるため、
#        状態ファイルだけでは「その会話の復帰がもう動いている」ことを検出できない
running_session_ids() {
  {
    scan_sessions open | cut -f1
    ps -ax -o args= 2>/dev/null | python3 -c '
import re, sys
pat = re.compile(r"(?:--resume|-r)(?:=|\s+)([0-9a-fA-F-]{36})")
for line in sys.stdin:
    for sid in pat.findall(line):
        print(sid)'
  } | sort -u
}

# tmux の pane_pid ごとに、その配下で動く claude セッションの RC 状態を TSV で返す
#   出力: pane_pid<TAB>state<TAB>sessionId
#   state: connected（bridgeSessionId あり）/ pending（状態ファイルはあるが RC 未登録）/ missing（未検出）
#   tmux はコマンドを sh -c で実行するため、claude の PID は pane_pid 本人（exec 最適化時）か
#   その子孫になる。ps の親子関係を辿って対応づける
pane_rc_status() {
  python3 - "$SESSIONS_DIR" "$@" <<'PY'
import glob, json, os, subprocess, sys
from datetime import datetime, timezone
sessions_dir = sys.argv[1]
targets = [int(x) for x in sys.argv[2:] if x.strip().isdigit()]
parent = {}
started_at = {}
args_of = {}
out = subprocess.run(["ps", "-ax", "-o", "pid=,ppid=,lstart=,args="], capture_output=True, text=True).stdout
for line in out.splitlines():
    parts = line.split(None, 7)   # pid + ppid + lstart(5語) + args
    if len(parts) < 8:
        continue
    try:
        pid, ppid = int(parts[0]), int(parts[1])
    except ValueError:
        continue
    parent[pid] = ppid
    args_of[pid] = parts[7]
    try:
        local = datetime.strptime(" ".join(parts[2:7]), "%a %b %d %H:%M:%S %Y")
        started_at[pid] = local.astimezone().astimezone(timezone.utc).replace(tzinfo=None)
    except Exception:
        pass

def same_process(d, pid):
    """状態ファイルの pid が、それを書いたプロセス本人か（PID 再利用よけ）"""
    if pid not in parent:
        return False
    ps_start = d.get("procStart")
    if isinstance(ps_start, str) and pid in started_at:
        try:
            recorded = datetime.strptime(ps_start.strip(), "%a %b %d %H:%M:%S %Y")
            return abs((recorded - started_at[pid]).total_seconds()) <= 1
        except Exception:
            pass
    return "claude" in args_of.get(pid, "").lower()
def ancestor_depth(pid, target, limit=5):
    depth = 0
    while depth <= limit:
        if pid == target:
            return depth
        if pid not in parent:
            return None
        pid = parent[pid]
        depth += 1
    return None
# 同一 pane 配下に複数のセッションがマッチし得る（復帰した claude が子の claude を
# 起動した場合など）。pane に最も近いプロセスを採用し、同深度なら connected を優先する
best = {t: None for t in targets}
for path in sorted(glob.glob(os.path.join(sessions_dir, "*.json"))):
    try:
        d = json.load(open(path))
    except Exception:
        continue
    # scan_sessions と同じ条件で絞る（kind と、状態ファイルを書いた本人かの検証。
    # 死んだプロセスの残存ファイルを PID 再利用のプロセスと誤対応させないため）
    if d.get("kind") != "interactive":
        continue
    pid = d.get("pid")
    if not isinstance(pid, int):
        continue
    if not same_process(d, pid):
        continue
    for t in targets:
        depth = ancestor_depth(pid, t)
        if depth is None:
            continue
        state = "connected" if d.get("bridgeSessionId") else "pending"
        cand = (depth, 0 if state == "connected" else 1, state, d.get("sessionId") or "")
        if best[t] is None or cand[:2] < best[t][:2]:
            best[t] = cand
for t in targets:
    if best[t] is None:
        print(f"{t}\tmissing\t")
    else:
        print(f"{t}\t{best[t][2]}\t{best[t][3]}")
PY
}

# "pane_pid<TAB>label" の組を受け取り、各 pane 配下のセッションが RC 登録されるまで待つ
#   登録を確認できたものから順に結果を表示し、全滅／タイムアウトで抜ける。
#   1 件でも未登録があれば非 0 を返す
wait_rc_registration() {
  local timeout="$1"; shift
  local -a entries panes
  entries=("$@")
  typeset -A label_of state_of present
  local e pane label deadline st sid ng=0 all_done out panes_now
  panes=()
  for e in "${entries[@]}"; do
    pane="${e%%$'\t'*}"
    label="${e#*$'\t'}"
    [[ -z "$pane" ]] && continue
    panes+=("$pane")
    label_of[$pane]="$label"
    state_of[$pane]="missing"
  done
  (( ${#panes} )) || return 0
  deadline=$(( $(date +%s) + timeout ))
  while :; do
    out=$(pane_rc_status "${panes[@]}")
    print -r -- "$out" | while IFS=$'\t' read -r pane st sid; do
      case "${state_of[$pane]:-}" in connected|died|vanished) continue ;; esac
      if [[ "$st" == connected ]]; then
        state_of[$pane]="connected"
        ok "${label_of[$pane]}: RC 登録を確認しました"
      else
        state_of[$pane]="$st"
      fi
    done
    # claude が異常終了した pane の検知（remain-on-exit failed で残っているもの）と、
    # pane ごと消えたケース（正常終了、または tmux が remain-on-exit failed 未対応）の検知
    panes_now=$(tmux list-panes -s -t "=$TMUX_SESSION" -F '#{pane_pid} #{pane_dead}' 2>/dev/null)
    if [[ -n "$panes_now" ]]; then
      present=()
      print -r -- "$panes_now" | while read -r pane st; do
        present[$pane]=1
        if [[ "$st" == 1 && -n "${label_of[$pane]:-}" && "${state_of[$pane]}" != connected && "${state_of[$pane]}" != died ]]; then
          state_of[$pane]="died"
          err "${label_of[$pane]}: claude が終了しています（tmux attach -t $TMUX_SESSION で pane のエラーを確認）"
        fi
      done
      for pane in "${panes[@]}"; do
        case "${state_of[$pane]}" in connected|died|vanished) continue ;; esac
        if [[ -z "${present[$pane]:-}" ]]; then
          state_of[$pane]="vanished"
          err "${label_of[$pane]}: pane が終了して消えています（claude が終了した可能性。tmux attach -t $TMUX_SESSION で確認）"
        fi
      done
    fi
    all_done=1
    for pane in "${panes[@]}"; do
      case "${state_of[$pane]}" in connected|died|vanished) ;; *) all_done=0 ;; esac
    done
    (( all_done )) && break
    (( $(date +%s) >= deadline )) && break
    if (( ${#CONFIRM_DIALOG_ENTRIES[@]} > 0 )); then
      # auto はハードコードせず呼び出し元の指定（CONFIRM_AUTO）に従う。
      # ここで 1 を固定すると、--auto-confirm を付けていない restore でも
      # trust 確認に Enter が送られ、権限設定を無断承認してしまう
      handle_confirm_dialogs "$CONFIRM_AUTO" "$RESUME_MODE" "${CONFIRM_DIALOG_ENTRIES[@]}"
    fi
    sleep 2
  done
  for pane in "${panes[@]}"; do
    case "${state_of[$pane]}" in
      connected) ;;
      died|vanished) (( ng++ )) || true ;;
      pending)
        warn "${label_of[$pane]}: 起動は確認できましたが、時間内に RC 登録されませんでした"
        (( ng++ )) || true ;;
      *)
        warn "${label_of[$pane]}: claude セッションの起動を確認できませんでした"
        (( ng++ )) || true ;;
    esac
  done
  return $(( ng > 0 ))
}

count_unregistered_entries() {
  local -a entries panes
  entries=("$@")
  local e pane out
  panes=()
  for e in "${entries[@]}"; do
    pane="${e%%$'\t'*}"
    [[ -n "$pane" ]] && panes+=("$pane")
  done
  (( ${#panes} )) || { print -- 0; return 0; }
  out=$(pane_rc_status "${panes[@]}")
  print -r -- "$out" | awk -F '\t' '$2 != "connected" { count++ } END { print count + 0 }'
}

confirm_wave_continue() {
  local count="$1" yes="$2" ans
  (( count > 0 )) || return 0
  if (( yes )); then
    warn "${count}件がRC未登録のまま。--yes のため続行します"
    return 0
  fi
  # この関数は restore / recover の起動ループ（done <<< "$limited_rows"）の内側から呼ばれる。
  # ループの stdin は未処理の候補行なので、端末から読まないと次の候補行を回答として
  # 食ってしまい（その会話は起動もされず黙って消える）、y/N の確認も成立しない
  if [[ ! -c /dev/tty ]] || ! { : </dev/tty ; } 2>/dev/null; then
    warn "${count}件がRC未登録のまま。端末が無いため確認できません → 中断します（自動実行では --yes を付けてください）"
    return 1
  fi
  printf "%s件がRC未登録のまま。続行しますか(y/N): " "$count"
  read -r ans </dev/tty || ans=""
  [[ "$ans" == [yY]* ]]
}

pick_rows() {
  local mode="$1" rows="$2" ans selected
  if [[ ! -t 0 ]]; then
    err "--pick は対話環境（標準入力が tty）でのみ使えます"
    err "非対話では --pick を外して通常モードで実行してください"
    return 1
  fi
  [[ -n "$rows" ]] || return 0
  print -- "復元候補:" >&2
  if ! print -r -- "$rows" | python3 -c '
import datetime, sys
mode = sys.argv[1]
for i, line in enumerate(sys.stdin.read().splitlines(), 1):
    if not line:
        continue
    if mode == "restore":
        parts = line.split("\t", 2)
        epoch = parts[0] if len(parts) > 0 else ""
        label = parts[1] if len(parts) > 1 else ""
        raw = parts[2].split("\t") if len(parts) > 2 else []
        cwd = raw[1] if len(raw) > 1 else ""
        try:
            when = datetime.datetime.fromtimestamp(int(epoch)).strftime("%Y-%m-%d %H:%M") if int(epoch) > 0 else "-"
        except Exception:
            when = "-"
        name = label or (raw[0] if raw else "")
    else:
        parts = line.split("\t")
        when = parts[0] if len(parts) > 0 else "-"
        sid = parts[1] if len(parts) > 1 else ""
        cwd = parts[2] if len(parts) > 2 else ""
        title = parts[4] if len(parts) > 4 else ""
        name = title or sid
    # f-string の置換フィールドにバックスラッシュは書けない（どの Python でも SyntaxError）ため
    # 一覧の整形は % 書式で行う
    print("%s\t%s\t%s\t%s" % (i, when, name or "(無名)", cwd or "(不明)"))
' "$mode" >&2; then
    err "復元候補の一覧表示に失敗しました"
    return 1
  fi
  printf "復元する番号をカンマ区切りで入力(例: 1,3,5)。a=全部、q=中止: " >&2
  read -r ans || ans=""
  case "$ans" in
    [aA]) print -r -- "$rows"; return 0 ;;
    [qQ]|"") err "選択を中止しました"; return 1 ;;
  esac
  selected=$(print -r -- "$rows" | PICK_SELECTION="$ans" python3 -c '
import os, sys
raw = [line for line in sys.stdin.read().splitlines() if line]
sel = os.environ.get("PICK_SELECTION", "")
nums = []
try:
    for part in sel.split(","):
        part = part.strip()
        if not part:
            raise ValueError
        n = int(part)
        if n < 1 or n > len(raw):
            raise ValueError
        if n not in nums:
            nums.append(n)
except ValueError:
    print("番号指定が不正です", file=sys.stderr)
    sys.exit(2)
for n in nums:
    print(raw[n - 1])
')
  if (( $? != 0 )); then
    err "復元候補の選択に失敗しました"
    return 1
  fi
  print -r -- "$selected"
}

# RC 登録済みの pane に「要約して」を 1 通送る
#   アカウント切り替え後の RC セッションには切り替え前の履歴が送られない
#   （Claude Code のクロスアカウント抑止。仕組みは README 参照）。
#   一方、RC 確立後の新しいやりとりは通常どおり双方向に同期されるため、
#   復帰直後に要約を 1 通送っておけば、スマホ / claude.ai/code 側にも文脈が残る。
#   引数: "pane_pid<TAB>label" の組。RC 未登録の pane には送らない（送っても
#   ローカルに要約が出るだけでリモートには届かないため）
send_recap() {
  local -a entries panes
  entries=("$@")
  typeset -A label_of id_of
  local e pane label rows pid pane_id st sid sent=0 skipped=0
  panes=()
  for e in "${entries[@]}"; do
    pane="${e%%$'\t'*}"
    label="${e#*$'\t'}"
    [[ -z "$pane" ]] && continue
    panes+=("$pane")
    label_of[$pane]="$label"
  done
  (( ${#panes} )) || return 0

  # send-keys の宛先は pane_pid ではなく pane_id なので対応表を作る
  rows=$(tmux list-panes -s -t "=$TMUX_SESSION" -F '#{pane_pid} #{pane_id}' 2>/dev/null)
  [[ -n "$rows" ]] && print -r -- "$rows" | while read -r pid pane_id; do
    id_of[$pid]="$pane_id"
  done

  print
  print -- "── 経緯の要約を送信 ──"
  print -r -- "$(pane_rc_status "${panes[@]}")" | while IFS=$'\t' read -r pid st sid; do
    [[ -n "${label_of[$pid]:-}" ]] || continue
    if [[ "$st" != connected || -z "${id_of[$pid]:-}" ]]; then
      warn "${label_of[$pid]}: RC 未登録のため要約は送りません"
      (( skipped++ )) || true
      continue
    fi
    # 入力を literal で送ってから Enter（TUI が入力を取り込む時間を確保する）
    tmux send-keys -t "${id_of[$pid]}" -l -- "$RECAP_PROMPT"
    sleep 0.5
    tmux send-keys -t "${id_of[$pid]}" Enter
    ok "${label_of[$pid]}: 要約を依頼しました"
    (( sent++ )) || true
  done
  if (( sent )); then
    info "要約の応答がリモート（claude.ai/code / モバイル）にも表示されます"
  fi
  return $(( skipped > 0 ))
}

# "loggedIn plan email" の3語を返す
auth_info() {
  claude auth status 2>/dev/null | python3 -c '
import sys, json
try:
    d = json.load(sys.stdin)
except Exception:
    d = {}
print("yes" if d.get("loggedIn") else "no", d.get("subscriptionType") or "-", d.get("email") or "-")'
}

# 作業ディレクトリ → ~/.claude/projects/ 配下のディレクトリ名（非英数字を - に置換）
encode_project_dir() {
  print -r -- "$1" | sed 's/[^A-Za-z0-9]/-/g'
}

# 会話ログ（transcript）のパスを返す。見つからなければ非 0
#   通常は「非英数字を - に置換」した名前だが、Claude Code は変換後 200 文字を超えると
#   200 文字で切り詰めてフルパスのハッシュを足す。古い会話は別の変換規則のこともある。
#   そのため、規則どおりの場所に無ければ projects 配下を sessionId で総当たりする
find_transcript() {
  local cwd="$1" sid="$2" p
  local -a hits
  p="$HOME/.claude/projects/$(encode_project_dir "$cwd")/$sid.jsonl"
  if [[ -f "$p" ]]; then
    print -r -- "$p"
    return 0
  fi
  eval 'hits=("$HOME/.claude/projects"/*/"$sid.jsonl"(N))'
  if (( ${#hits} )); then
    print -r -- "${hits[1]}"
    return 0
  fi
  return 1
}

# 会話ログにクロスアカウント抑止の永続レコードがあるか（0 = 抑止済み / 1 = なし）
#   Claude Code は、会話に記録された所有アカウントと現在のログインが食い違う状態で
#   RC を張ろうとすると、リモートへの履歴アップロードを止めたうえで会話ログに
#   {"type":"history-suppression", "cause":"chokepoint_veto", ...} を追記する。
#   このレコードが付いた会話は、以後どのアカウントで開いてもリモート側に履歴が出ない。
#   会話本文にこの語が出てくる誤検出を避けるため、候補行を JSON として type まで検証する
transcript_history_suppressed() {
  python3 - "$1" <<'PY'
import json, sys
try:
    with open(sys.argv[1], "rb") as f:
        for raw in f:
            if b'history-suppression' not in raw:
                continue
            try:
                if json.loads(raw.decode("utf-8", "replace")).get("type") == "history-suppression":
                    sys.exit(0)
            except Exception:
                continue
except OSError:
    pass
sys.exit(1)
PY
}

# 会話ログ（transcript）の最終エントリの時刻を epoch 秒で返す
#   末尾 64KB だけ読んで最後の timestamp を拾う（ログは追記型で数十 MB になり得るため）。
#   timestamp が見つからなければファイルの mtime にフォールバック
transcript_last_epoch() {
  python3 - "$1" <<'PY'
import os, re, sys
from datetime import datetime

path = sys.argv[1]
epoch = None
try:
    with open(path, "rb") as f:
        f.seek(0, os.SEEK_END)
        f.seek(max(0, f.tell() - 65536))
        tail = f.read().decode("utf-8", "replace")
    # seek で先頭行が欠けていても拾えるよう、json.loads ではなく正規表現で探す
    for line in reversed(tail.splitlines()):
        m = re.search(r'"timestamp"\s*:\s*"([^"]+)"', line)
        if not m:
            continue
        try:
            epoch = datetime.fromisoformat(m.group(1).replace("Z", "+00:00")).timestamp()
            break
        except ValueError:
            continue
except OSError:
    pass
if epoch is None:
    try:
        epoch = os.path.getmtime(path)
    except OSError:
        epoch = 0
print(int(epoch))
PY
}

# 会話ログから表示名に使える短い文字列を作る
#   優先順位: custom-title / agent-name（会話に付いている名前。ログ先頭に来ることが多い）
#           → 最初のユーザー発言
#   Claude Code はスラッシュコマンド実行時や継続起動時に、先頭のユーザーエントリとして
#   <local-command-caveat> / <command-name> / <system-reminder> を注入する。
#   これを素で採用すると 'localcommandcaveatCaveat The m' のような名前になるため、
#   タグの中身は落とし、残りが空の発言は飛ばして次の発言を見る
transcript_first_user_title() {
  python3 - "$1" <<'PY'
import json, re, sys

MAX_LINES = 500  # 名前はログ先頭付近にしかないので、巨大ログを読み切らない

# Claude Code が注入する制御タグ（閉じタグが無い場合は行末まで）
TAG_RE = re.compile(
    r"(?is)<(local-command-caveat|system-reminder|command-name|command-message|"
    r"command-args|command-contents|command-stdout|command-stderr)\b.*?(?:</\1>|$)")


def clean(s):
    s = TAG_RE.sub(" ", s)
    s = re.sub(r"[\r\n\t]+", " ", s)
    s = re.sub(r"[^\w\s一-龯ぁ-んァ-ヶー]", "", s, flags=re.UNICODE)
    return re.sub(r"\s+", " ", s).strip()


title = ""
first_user = ""
try:
    with open(sys.argv[1], "r", encoding="utf-8", errors="replace") as f:
        for i, line in enumerate(f):
            if i >= MAX_LINES or title:
                break
            try:
                d = json.loads(line)
            except Exception:
                continue
            t = d.get("type")
            if t in ("custom-title", "agent-name"):
                v = d.get("customTitle") or d.get("agentName") or ""
                if isinstance(v, str):
                    title = clean(v)
                continue
            if first_user or t != "user" or d.get("isSidechain"):
                continue
            c = d.get("message", {}).get("content")
            if isinstance(c, list):
                c = " ".join(p.get("text", "") for p in c if isinstance(p, dict))
            if not isinstance(c, str):
                continue
            first_user = clean(c)
except OSError:
    pass
name = title or first_user
if name:
    print(name[:30])
    sys.exit(0)
sys.exit(1)
PY
}

# 空名 / UUID 風 / Claude 自動名なら、会話本文や cwd から復元名を作る
fallback_session_base_name() {
  local name="$1" transcript="$2" cwd="$3"
  local base="$name" needs_fallback=0 first cwd_base
  [[ "$base" == *-restored-* ]] && base="${base%%-restored-*}"
  if [[ -z "$base" ]]; then
    needs_fallback=1
  elif [[ "$base" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]; then
    needs_fallback=1
  elif [[ "$base" =~ ^[A-Za-z0-9-]+-[0-9]{4}-[0-9]{4}$ ]]; then
    needs_fallback=1
  fi
  if (( needs_fallback )); then
    first=$(transcript_first_user_title "$transcript" 2>/dev/null) || first=""
    if [[ -n "$first" ]]; then
      base="$first"
    else
      cwd_base=$(basename "$cwd" 2>/dev/null) || cwd_base=""
      base="${cwd_base:-restored-session}"
    fi
  fi
  eval 'base="${base[1,30]}"'
  print -r -- "$base"
}

# 実行中プロセスの起動引数から権限モード関連のフラグだけを抜き出す
#   権限モードは会話ではなくプロセス起動時の状態のため ~/.claude/sessions/*.json には残らない。
#   save の時点なら元プロセスが生きているので、コマンドラインから拾える。
#   ホワイトリスト方式（--resume 等の復帰時に邪魔な引数を巻き込まないため）
detect_perm_flags() {
  local pid="$1" args
  args=$(ps -p "$pid" -o args= 2>/dev/null) || return 0
  [[ -z "$args" ]] && return 0
  local -a words out
  words=(${=args})
  out=()
  local i=1
  while (( i <= ${#words} )); do
    case "${words[i]}" in
      --dangerously-skip-permissions|--allow-dangerously-skip-permissions)
        out+=("${words[i]}") ;;
      --permission-mode)
        # 値を取る形式。既知のモード名でなければ拾わない
        # （--append-system-prompt の値などに紛れた同名語を誤検出しないため）
        case "${words[i+1]:-}" in
          default|acceptEdits|auto|dontAsk|bypassPermissions|plan)
            out+=("${words[i]}" "${words[i+1]}")
            (( i++ )) ;;
        esac ;;
      --permission-mode=default|--permission-mode=acceptEdits|--permission-mode=auto|--permission-mode=dontAsk|--permission-mode=bypassPermissions|--permission-mode=plan)
        out+=("${words[i]}") ;;
      --permission-prompt-tool)
        if [[ "${words[i+1]:-}" == -* || -z "${words[i+1]:-}" ]]; then
          :
        else
          out+=("${words[i]}" "${words[i+1]}")
          (( i++ ))
        fi ;;
      --permission-prompt-tool=*)
        out+=("${words[i]}") ;;
    esac
    (( i++ ))
  done
  # 値を取るオプションが混ざっていると、その値の中身を誤検出し得る（引用符は ps では失われる）
  if (( ${#out} )) && [[ "$args" == *--append-system-prompt* || "$args" == *--system-prompt* ]]; then
    warn "pid $pid: --append-system-prompt 等の値に権限フラグと同じ語が含まれていると誤検出することがあります" >&2
  fi
  print -r -- "${out[*]}"
}

# この claude が -n / --name（セッションの表示名指定）に対応しているか
claude_supports_name() {
  claude --help 2>/dev/null | grep -q -- '--name'
}

# 復帰セッションに付ける表示名（Remote Control の一覧で復元品を見分けるため）
#   例: あすまるくん改修-immutable-cre-restored-0815
restored_session_name() {
  local prefix
  prefix=$(fallback_session_base_name "$1" "${2:-}" "${3:-}")
  print -r -- "${prefix}-restored-$(date '+%m%d')"
}

# vm_stat の free + inactive から空きメモリを概算し、600MB/件の起動予算を確認する
available_memory_mb() {
  command -v vm_stat >/dev/null 2>&1 || return 1
  local page_size
  page_size=$(pagesize 2>/dev/null) || page_size=4096
  vm_stat | awk -v page="$page_size" '
    /Pages free:/ { gsub("[^0-9]", "", $3); free=$3 }
    /Pages inactive:/ { gsub("[^0-9]", "", $3); inactive=$3 }
    END {
      mb = int(((free + inactive) * page) / 1024 / 1024)
      if (mb > 0) print mb
    }'
}

confirm_memory_budget() {
  local count="$1" yes="$2"
  (( count > 0 )) || return 0
  local free_mb budget_mb threshold_mb recommended free_gb budget_gb ans
  free_mb=$(available_memory_mb) || return 0
  [[ "$free_mb" =~ ^[0-9]+$ ]] || return 0
  (( budget_mb = count * 600 ))
  (( threshold_mb = free_mb * 70 / 100 ))
  (( budget_mb <= threshold_mb )) && return 0
  (( recommended = threshold_mb / 600 ))
  (( recommended < 1 )) && recommended=1
  budget_gb=$(awk -v mb="$budget_mb" 'BEGIN { printf "%.1f", mb / 1024 }')
  free_gb=$(awk -v mb="$free_mb" 'BEGIN { printf "%.1f", mb / 1024 }')
  warn "${count}件×600MB=${budget_gb}GB は空き${free_gb}GBに対して過大。--limit ${recommended} を推奨"
  (( yes )) && return 0
  printf "続行しますか? [y/N]: "
  read -r ans || ans=""
  [[ "$ans" == [yY]* ]]
}

# 未復元の残りを案内する
#   第 2 引数は案内に出すサブコマンド名。recover の候補は manifest に無いため、
#   restore を案内すると別の会話が起動してしまう（呼び出し元を必ず渡すこと）
report_limit_remainder() {
  local skipped_rows="$1" cmd="${2:-restore}"
  local count
  count=$(print -r -- "$skipped_rows" | sed '/^$/d' | wc -l | tr -d ' ')
  (( count > 0 )) || return 0
  warn "あと${count}件は復元していません。claude-rc-reattach ${cmd} --limit で追加できます"
  print -r -- "$skipped_rows" | while IFS=$'\t' read -r _epoch label _rest; do
    [[ -n "$label" ]] && info "• $label"
  done
}

# 確認ダイアログ待ちで RC 登録が進まなかった場合の案内
#   trust 系は自動承認しないため、restore ではここで人間に返す
report_confirm_pending() {
  (( CONFIRM_PENDING > 0 )) || return 0
  warn "${CONFIRM_PENDING} 個のセッションが確認ダイアログ待ちです（trust 確認は自動承認しません）"
  info "（tmux attach -t $TMUX_SESSION でウィンドウを開き、内容を確認して手動で応答してください）"
}

# tmux ウィンドウ名を作る
#   [^A-Za-z0-9_.-] を一括で潰すと日本語のラベルが全てダッシュになり（例:
#   「ミチガエル経営ダッシュボード」→「--------------」）、attach しても
#   どのウィンドウがどの会話か分からない。手動 kill-window の誤爆や reconnect の
#   出力での取り違えを招くため、非 ASCII はそのまま残す（tmux の名前は UTF-8 可）。
#   置き換えるのは tmux のターゲット指定で意味を持つ . : と空白・制御文字だけ。
#   先頭に sessionId の先頭 8 桁を付けて、同名ラベルでも一意に見分けられるようにする
tmux_window_name() {
  local label="$1" sid="${2:-}" name prefix
  name="${label//[[:space:][:cntrl:]]/-}"
  name="${name//[.:]/-}"
  [[ -z "$name" ]] && name="session"
  # 日本語は 1 文字あたり表示幅 2 になるため、ラベル部分は 20 文字までに抑える
  eval 'name="${name[1,20]}"'
  if [[ -n "$sid" ]]; then
    eval 'prefix="${sid[1,8]}"'
    print -r -- "${prefix}-${name}"
  else
    print -r -- "$name"
  fi
}

# tmux セッション "$TMUX_SESSION" に窓を作って claude を起動し、"pane_id<TAB>pane_pid" を返す
#   失敗時は err を出して非 0（呼び出し側は skip 扱いにする）
launch_pane() {
  local label="$1" win="$2" cwd="$3" cmd_str="$4" sid="${5:-}"
  local pane_id pane_pid
  # claude 起動前に remain-on-exit を設定できるよう、まず保持コマンドで pane を作り、
  # オプション設定後に respawn-pane で本来のコマンドへ差し替える。
  # 起動後に設定すると、claude が即異常終了した場合に pane ごと消えて
  # 原因確認できないレースがあるため
  if ! tmux has-session -t "=$TMUX_SESSION" 2>/dev/null; then
    pane_id=$(tmux new-session -d -P -F '#{pane_id}' -s "$TMUX_SESSION" -c "$cwd" -n "$win" 'sleep 600' </dev/null) || pane_id=""
  else
    pane_id=$(tmux new-window -t "$TMUX_SESSION" -P -F '#{pane_id}' -c "$cwd" -n "$win" 'sleep 600' </dev/null) || pane_id=""
  fi
  if [[ -z "$pane_id" ]]; then
    err "$label: tmux のウィンドウ作成に失敗しました → skip"
    return 1
  fi
  # claude が異常終了した場合だけ pane を残す（原因確認用）。
  # セッションターゲットへの set-option はカレントウィンドウにしか効かないため
  # pane 単位で設定する。未対応の tmux では無視
  tmux set-option -p -t "$pane_id" remain-on-exit failed 2>/dev/null || true
  # このツールが起動した pane であることと、どの会話かを pane に記録する。
  # restore / recover の再実行で二重起動しないため／reconnect が無関係な pane にキーを送らないため
  [[ -n "$sid" ]] && tmux set-option -p -t "$pane_id" '@rc_sid' "$sid" 2>/dev/null || true
  if ! tmux respawn-pane -k -t "$pane_id" "$cmd_str" 2>/dev/null; then
    err "$label: claude の起動に失敗しました → skip"
    tmux kill-pane -t "$pane_id" 2>/dev/null || true
    return 1
  fi
  pane_pid=$(tmux display-message -p -t "$pane_id" '#{pane_pid}' 2>/dev/null) || pane_pid=""
  if [[ -z "$pane_pid" ]]; then
    err "$label: 起動直後に pane が消えました → skip"
    return 1
  fi
  print -r -- "${pane_id}"$'\t'"${pane_pid}"
}

# manifest が無くても復帰できるよう、会話ログから復旧候補を列挙する
#   引数: 対象時間（h）, 除外する sessionId（いま動いているもの）...
#   出力: 最終更新<TAB>sessionId<TAB>cwd<TAB>プロジェクト<TAB>推定タイトル
#         （プロジェクト単位・最終更新の新しい順）
scan_recoverable() {
  local hours="$1"; shift
  python3 - "$PROJECTS_DIR" "$hours" "$@" <<'PY'
import glob, json, os, re, sys, time
from datetime import datetime

projects_dir, hours = sys.argv[1], int(sys.argv[2])
running = set(sys.argv[3:])
cutoff = time.time() - hours * 3600
uuid_re = re.compile(r"^[0-9a-fA-F-]{36}$")
cwd_re = re.compile(r'"cwd"\s*:\s*"([^"]+)"')

def probe(path):
    """先頭 256KB からタイトル・cwd・発言の有無を拾う
    （会話ログは数十 MB になり得るため全部は読まない）"""
    title = cwd = ""
    has_message = False
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            head = f.read(262144)
    except OSError:
        return title, cwd, has_message
    m = cwd_re.search(head)
    if m:
        cwd = m.group(1)
    for line in head.splitlines():
        try:
            d = json.loads(line)
        except Exception:
            continue
        t = d.get("type")
        if t in ("user", "assistant"):
            has_message = True
        if t in ("custom-title", "agent-name") and not title:
            title = d.get("customTitle") or d.get("agentName") or ""
        # 名前が付いていない会話は、最初のユーザー発言の冒頭をタイトル代わりにする
        if not title and t == "user" and not d.get("isSidechain"):
            c = d.get("message", {}).get("content")
            if isinstance(c, list):
                c = " ".join(p.get("text", "") for p in c if isinstance(p, dict))
            if isinstance(c, str):
                title = c
    return " ".join(title.split())[:40], cwd, has_message

rows = []
for path in glob.glob(os.path.join(projects_dir, "*", "*.jsonl")):
    name = os.path.basename(path)
    # サブエージェントのログは会話そのものではないので対象外
    if "/subagents/" in path or name.startswith("agent-"):
        continue
    sid = name[: -len(".jsonl")]
    if not uuid_re.match(sid) or sid in running:
        continue
    try:
        mtime = os.path.getmtime(path)
    except OSError:
        continue
    if mtime < cutoff:
        continue
    title, cwd, has_message = probe(path)
    # 発言が 1 つも無いログ（タイトル行だけ残った空セッション等）は復帰しても意味がない
    if not has_message:
        continue
    rows.append((os.path.basename(os.path.dirname(path)), -mtime, sid, cwd, title))

for proj, negmtime, sid, cwd, title in sorted(rows, key=lambda x: x[1]):
    when = datetime.fromtimestamp(-negmtime).strftime("%Y-%m-%d %H:%M")
    print("\t".join([when, sid, cwd, proj, title]))
PY
}

# 起動直後の確認ダイアログ（trust 確認 / Resume full session as-is 等）を検出する
#   auto=1 なら trust 確認にも Enter を送って進める（連続する最大 3 段まで）。
#   resume-mode は選択肢番号を capture から拾って送る。
#   結果（ダイアログ待ちのまま残った pane の数）は CONFIRM_PENDING に入れる
#   （進捗表示を出すため、標準出力では返さない）
handle_confirm_dialogs() {
  local auto="$1" resume_mode="${2:-as-is}"; shift 2
  local -a entries
  entries=("$@")
  local e pane_id label out step pending=0 choice
  for e in "${entries[@]}"; do
    pane_id="${e%%$'\t'*}"
    label="${e#*$'\t'}"
    # 4 周目は「3 回送っても消えないダイアログ」を待ち扱いにするための確認だけ
    for step in 1 2 3 4; do
      out=$(tmux capture-pane -p -t "$pane_id" 2>/dev/null) || break
      if [[ "$out" == *"Resume full session as-is"* ]]; then
        choice=$(CHOICE_TEXT="$out" python3 - "$resume_mode" <<'PY'
import os, re, sys
mode = sys.argv[1]
text = os.environ.get("CHOICE_TEXT", "")
# フォーカス中の行は先頭にポインタ（❯）などの装飾が付くため、行頭の非数字は読み飛ばす
# （\s* だけだと "❯ 1. Resume from summary" に一致せず、選択肢を取りこぼす）
choices = re.findall(r"(?m)^[^0-9\n]*([0-9]+)\.\s*(.+?)\s*$", text)
if mode == "as-is":
    for n, label in choices:
        if "Resume full session as-is" in label:
            print(n)
            break
else:
    for n, label in choices:
        if "Resume from summary" in label:
            print(n)
            break
    else:
        # 表記が変わった場合の保険。"Don't ask me again"（以後この確認を出さない設定）は選ばない
        for n, label in choices:
            if "Resume full session as-is" in label or "ask me again" in label:
                continue
            print(n)
            break
PY
)
        if [[ -n "$choice" && "$step" -le 3 ]]; then
          tmux send-keys -t "$pane_id" "$choice"
          sleep 0.2
          tmux send-keys -t "$pane_id" Enter
          info "$label: resume-mode=$resume_mode の選択肢 $choice を送信しました"
          sleep 2
          continue
        fi
        (( pending++ )) || true
        break
      elif [[ "$out" == *"Yes, I trust"* ]]; then
        # trust 系ダイアログへの Enter は「承認」そのもの（.claude/settings.json の
        # permissions.allow の無確認適用 / managed settings の承認）なので、
        # --auto-confirm を明示していない限り自動応答せず、人間の判断に返す
        if (( ! auto || step > 3 )); then
          (( pending++ )) || true
          break
        fi
        tmux send-keys -t "$pane_id" Enter
        info "$label: trust 確認に Enter を送信しました（${step} 段目）"
        sleep 2
      elif [[ "$out" == *"Enter to confirm"* ]]; then
        if (( ! auto || step > 3 )); then
          (( pending++ )) || true
          break
        fi
        tmux send-keys -t "$pane_id" Enter
        info "$label: 確認ダイアログに Enter を送信しました（${step} 段目）"
        sleep 2
      else
        break
      fi
    done
  done
  CONFIRM_PENDING=$pending
}

cmd_list() {
  need python3
  local rows
  rows=$(scan_sessions rc)
  if [[ -z "$rows" ]]; then
    info "RC 接続中の会話はありません"
    return 0
  fi
  print -- "RC 接続中の会話（save で保存される対象）:"
  local mark transcript line sid cwd name pid
  local -a f
  # IFS=$'\t' read は連続タブを 1 個に畳むため、name が空だと列がずれる。
  # (@ps:\t:) なら空フィールドがそのまま残る
  print -r -- "$rows" | while IFS= read -r line; do
    eval 'f=("${(@ps:\t:)line}")'
    sid="${f[1]:-}"; cwd="${f[2]:-}"; name="${f[3]:-}"; pid="${f[4]:-}"
    [[ -z "$sid" ]] && continue
    # 既にクロスアカウント抑止が付いた会話は、復帰してもリモートに履歴が出ない
    mark=""
    transcript=$(find_transcript "$cwd" "$sid") \
      && transcript_history_suppressed "$transcript" \
      && mark="  ⚑ リモート履歴は抑止済み"
    print -- "  • ${name:-(無名)}  [$cwd]  session=$sid  pid=$pid$mark"
  done
}

cmd_save() {
  need python3
  local rows
  rows=$(scan_sessions rc)
  if [[ -z "$rows" ]]; then
    err "RC 接続中の会話が見つかりません。manifest は変更していません"
    err "（RC 接続中のセッションを開いた状態で実行してください。/rc active がフッターに出ているか確認）"
    return 1
  fi
  # 5 列目として権限モードのフラグを記録する（restore で引き継ぐため）。
  # 元プロセスが生きているこの時点でしか取れない情報
  local rows_ext line sid cwd name pid perm
  local -a f
  rows_ext=$(print -r -- "$rows" | while IFS= read -r line; do
    eval 'f=("${(@ps:\t:)line}")'
    sid="${f[1]:-}"; cwd="${f[2]:-}"; name="${f[3]:-}"; pid="${f[4]:-}"
    [[ -z "$sid" ]] && continue
    printf '%s\t%s\t%s\t%s\t%s\n' "$sid" "$cwd" "$name" "$pid" "$(detect_perm_flags "$pid")"
  done)

  # 書き込みの成否は必ず判定する。switch はこの直後に logout するため、
  # 書けていないのに「保存しました」と返すと旧アカウントのトークンを失効させたあとで
  # manifest が無いことに気づく（復帰不能）ことになる
  if ! mkdir -p "${MANIFEST:h}" 2>/dev/null; then
    err "manifest の保存先ディレクトリを作成できません: ${MANIFEST:h}"
    err "（CLAUDE_RC_MANIFEST の指定を確認してください）"
    return 1
  fi
  local email tmp_manifest
  email=$(auth_info | awk '{print $3}')
  # 一時ファイルへ書いてから mv で差し替える（途中で失敗・中断しても
  # 前回の正常な manifest を半端な内容で上書きしないため）
  if ! tmp_manifest=$(mktemp "${MANIFEST:h}/.manifest.XXXXXX" 2>/dev/null) || [[ -z "$tmp_manifest" ]]; then
    err "manifest の一時ファイルを作成できません: ${MANIFEST:h}"
    return 1
  fi
  if ! {
    print -- "# claude-rc-reattach manifest v2"
    print -- "# saved_at=$(date '+%Y-%m-%dT%H:%M:%S%z') account=$email"
    print -r -- "$rows_ext"
  } > "$tmp_manifest"; then
    err "manifest の書き込みに失敗しました: $MANIFEST"
    rm -f "$tmp_manifest"
    return 1
  fi
  if ! mv -f "$tmp_manifest" "$MANIFEST" 2>/dev/null; then
    err "manifest を配置できません: $MANIFEST"
    rm -f "$tmp_manifest"
    return 1
  fi
  local n
  n=$(print -r -- "$rows_ext" | wc -l | tr -d ' ')
  ok "$n 件の会話を保存しました → $MANIFEST"
  print -r -- "$rows_ext" | while IFS= read -r line; do
    eval 'f=("${(@ps:\t:)line}")'
    sid="${f[1]:-}"; cwd="${f[2]:-}"; name="${f[3]:-}"; perm="${f[5]:-}"
    [[ -z "$sid" ]] && continue
    if [[ -n "$perm" ]]; then
      info "• ${name:-(無名)}  [$cwd]  権限モード: $perm"
      # bypass は誤検出時の影響が大きいので、既定では引き継がないことを明示する
      if [[ "$perm" == *--dangerously-skip-permissions* || "$perm" == *bypassPermissions* ]]; then
        info "  ↑ bypass 系は既定では引き継ぎません（restore --inherit-bypass で引き継げます）"
      fi
    else
      info "• ${name:-(無名)}  [$cwd]"
    fi
  done
}

cmd_restore() {
  local fork=1 dry=0 inherit_perms=1 force=0 rename=1 recap=1 inherit_bypass=0 yes=0 limit="$MAX_SESSIONS" pick=0 wave_size="$WAVE_SIZE"
  RESUME_MODE="as-is"
  # restore に --auto-confirm は無い。trust 確認は自動承認せず人間に返す
  CONFIRM_AUTO=0
  while (( $# )); do
    case "$1" in
      --fork)    fork=1 ;;
      --no-fork) fork=0 ;;
      --dry-run) dry=1 ;;
      --yes)     yes=1 ;;
      --force)   force=1 ;;
      --no-rename) rename=0 ;;
      --no-inherit-perms) inherit_perms=0 ;;
      --inherit-bypass)   inherit_bypass=1 ;;
      --recap)   recap=1 ;;
      --no-recap) recap=0 ;;
      --pick)    pick=1 ;;
      --limit)
        shift
        if [[ ! "${1:-}" =~ ^[0-9]+$ ]]; then
          err "--limit には件数（数値）を指定してください"
          return 1
        fi
        limit="$1" ;;
      --limit=*)
        limit="${1#--limit=}"
        if [[ ! "$limit" =~ ^[0-9]+$ ]]; then
          err "--limit には件数（数値）を指定してください"
          return 1
        fi ;;
      --wave-size)
        shift
        if [[ ! "${1:-}" =~ ^[0-9]+$ ]]; then
          err "--wave-size には件数（数値）を指定してください"
          return 1
        fi
        wave_size="$1" ;;
      --wave-size=*)
        wave_size="${1#--wave-size=}"
        if [[ ! "$wave_size" =~ ^[0-9]+$ ]]; then
          err "--wave-size には件数（数値）を指定してください"
          return 1
        fi ;;
      --resume-mode)
        shift
        case "${1:-}" in
          as-is|summary) RESUME_MODE="$1" ;;
          *) err "--resume-mode は as-is または summary を指定してください"; return 1 ;;
        esac ;;
      --resume-mode=*)
        case "${1#--resume-mode=}" in
          as-is|summary) RESUME_MODE="${1#--resume-mode=}" ;;
          *) err "--resume-mode は as-is または summary を指定してください"; return 1 ;;
        esac ;;
      *) err "不明なオプション: $1"; return 1 ;;
    esac
    shift
  done
  need python3
  need_tmux || return 1
  need claude

  if [[ ! -f "$MANIFEST" ]]; then
    err "manifest がありません: $MANIFEST"
    err "（アカウント切り替え前に 'claude-rc-reattach save' を実行しておく必要があります）"
    return 1
  fi

  local logged plan email
  read -r logged plan email <<< "$(auth_info)"
  if [[ "$logged" != "yes" ]]; then
    err "未ログインです。先に 'claude auth login' を実行してください"
    return 1
  fi
  ok "ログイン中: $email (plan: $plan)"
  case "$plan" in
    pro|max|team|enterprise) ;;
    *) warn "プラン '$plan' で Remote Control が使えるかは不明です（対象: Pro/Max/Team/Enterprise）" ;;
  esac

  # いま別プロセスで開かれている・すでに復帰済みの会話（同じ会話を二重に立ち上げないため）
  # 波ごとの RC 確認で全体は数分かかるため、この一覧はループ内で 1 件ごとに取り直す
  # （起動中に別の restore や手動の claude --resume が始まっても検知できるようにする）
  local open_ids
  open_ids=$(running_session_ids)

  # 復帰セッションに名前を付けられるか（claude のバージョンによっては -n が無い）
  local name_ok=0
  if (( rename )); then
    if claude_supports_name; then
      name_ok=1
    else
      info "この claude は -n（セッション名）に未対応のため、名前を付けずに起動します"
    fi
  fi

  # 注意: zsh ではループ内で `local` を再宣言すると変数の中身が出力されるため、
  # ループで使う変数はここでまとめて宣言する
  # CLAUDE_RC_CLAUDE_ARGS: restore 時の claude コマンドに追加するオプション
  # （権限モードは resume で引き継がれないため、--dangerously-skip-permissions 等はここで渡す）
  # (z) でシェルと同じ規則に分割し、(Q) で引数を囲むクォートを外す
  # （"--append-system-prompt 'foo bar'" のようにスペースを含む引数も 1 個として渡せる）
  local -a claude_extra
  eval 'claude_extra=(${(Q)${(z)${CLAUDE_RC_CLAUDE_ARGS:-}}})'
  (( ${#claude_extra} )) && info "claude 追加オプション: ${claude_extra[*]}"

  # 環境変数側で権限モードを明示していたら、manifest から引き継いだ分は使わない（二重指定の回避）
  # 判定対象は detect_perm_flags のホワイトリストと同じ 4 フラグ
  # （--allow-dangerously-skip-permissions は --dangerously-skip-permissions の
  #   substring パターンに一致しないため個別に列挙する）
  local perm_override=0
  if [[ "${claude_extra[*]}" == *--dangerously-skip-permissions* \
     || "${claude_extra[*]}" == *--allow-dangerously-skip-permissions* \
     || "${claude_extra[*]}" == *--permission-mode* \
     || "${claude_extra[*]}" == *--permission-prompt-tool* ]]; then
    perm_override=1
  fi

  # RC は起動時に明示する。settings.json の remoteControlAtStartup 頼みだと、
  # 設定が無い / 効いていない環境では 60 秒待ってから ⚠ になり reconnect 送りになる。
  # 環境変数側で既に指定されている場合は二重指定しない
  local rc_flag=1
  [[ "${claude_extra[*]}" == *--remote-control* ]] && rc_flag=0

  # このツールが既に復帰させた会話（tmux pane に @rc_sid で印を付けてある）。
  # restore を再実行したときに、成功済みの会話まで複製してしまうのを防ぐ
  local restored_ids
  restored_ids=$(tmux list-panes -s -t "=$TMUX_SESSION" -F '#{pane_dead} #{@rc_sid}' 2>/dev/null \
    | while read -r _dead _sid; do [[ "$_dead" == 0 && -n "$_sid" ]] && print -r -- "$_sid"; done)

  local manifest_rows sorted_rows eligible_rows limited_rows remainder_rows planned_count skipped_pre=0
  manifest_rows=$(while IFS= read -r line; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    eval 'f=("${(@ps:\t:)line}")'
    sid="${f[1]:-}"; cwd="${f[2]:-}"; name="${f[3]:-}"
    [[ -z "$sid" ]] && continue
    label="${name:-$sid}"
    if transcript=$(find_transcript "$cwd" "$sid" 2>/dev/null); then
      last_epoch=$(transcript_last_epoch "$transcript")
    else
      last_epoch=0
    fi
    printf '%s\t%s\t%s\n' "$last_epoch" "$label" "$line"
  done < "$MANIFEST" | sort -rn -t $'\t' -k1,1)

  # limit を掛ける前に「確実に skip になる行」を落とす。
  # 実行中の会話は会話ログが最も新しいためソートの先頭に並ぶので、先に切り詰めると
  # skip 行が limit の枠を食い潰し、案内どおり restore --limit を再実行しても
  # 未起動の会話に永久に到達できない（起動 0 件・終了コード 1 のまま）
  local pre_now pre_sid pre_cwd pre_name pre_label pre_epoch pre_slabel pre_line pre_age
  local -a eligible_lines pre_f
  typeset -A pre_seen_sids
  eligible_lines=()
  pre_now=$(date +%s)
  while IFS=$'\t' read -r pre_epoch pre_slabel pre_line; do
    [[ -z "$pre_line" ]] && continue
    eval 'pre_f=("${(@ps:\t:)pre_line}")'
    pre_sid="${pre_f[1]:-}"; pre_cwd="${pre_f[2]:-}"; pre_name="${pre_f[3]:-}"
    [[ -z "$pre_sid" ]] && continue
    pre_label="${pre_name:-$pre_sid}"

    if [[ -n "${pre_seen_sids[$pre_sid]:-}" ]]; then
      warn "$pre_label: manifest 内で重複している会話です → skip（同じ会話ログへの多重書き込みを防ぐため）"
      (( skipped_pre++ )) || true
      continue
    fi
    pre_seen_sids[$pre_sid]=1

    if print -r -- "$restored_ids" | grep -Fqx -- "$pre_sid"; then
      warn "$pre_label: 既に復帰済みで tmux ウィンドウが生きています → skip"
      info "  RC が切れている場合は claude-rc-reattach reconnect を使ってください"
      (( skipped_pre++ )) || true
      continue
    fi

    if [[ ! -d "$pre_cwd" ]]; then
      err "$pre_label: 作業ディレクトリが存在しません → skip ($pre_cwd)"
      (( skipped_pre++ )) || true
      continue
    fi

    if ! find_transcript "$pre_cwd" "$pre_sid" >/dev/null 2>&1; then
      err "$pre_label: 会話ログが見つかりません → skip (~/.claude/projects/*/$pre_sid.jsonl)"
      (( skipped_pre++ )) || true
      continue
    fi

    if (( MAX_AGE_DAYS > 0 && pre_now - pre_epoch > MAX_AGE_DAYS * 86400 )); then
      (( pre_age = (pre_now - pre_epoch) / 86400 )) || true
      warn "$pre_label: 最終チャットが ${pre_age} 日前（上限 ${MAX_AGE_DAYS} 日）→ skip"
      (( skipped_pre++ )) || true
      continue
    fi

    if print -r -- "$open_ids" | grep -Fqx -- "$pre_sid"; then
      if (( ! force )); then
        info "skip (already running): $pre_label"
        (( skipped_pre++ )) || true
        continue
      fi
      if (( ! fork )); then
        err "$pre_label: この会話は別プロセスで開いたままです → skip（--force --no-fork 指定のため。複製復帰でよければ --no-fork を外して実行）"
        (( skipped_pre++ )) || true
        continue
      fi
    fi

    eligible_lines+=("${pre_epoch}"$'\t'"${pre_slabel}"$'\t'"${pre_line}")
  done <<< "$manifest_rows"
  # zsh 専用の展開は bash -n でも構文エラーにならないよう eval 経由で書く
  eval 'eligible_rows="${(F)eligible_lines}"'

  if (( limit > 0 )); then
    limited_rows=$(print -r -- "$eligible_rows" | awk -F '\t' -v limit="$limit" 'NR <= limit')
    remainder_rows=$(print -r -- "$eligible_rows" | awk -F '\t' -v limit="$limit" 'NR > limit')
  else
    limited_rows="$eligible_rows"
    remainder_rows=""
  fi
  if (( pick )); then
    limited_rows=$(pick_rows restore "$limited_rows") || return 1
  fi
  planned_count=$(print -r -- "$limited_rows" | sed '/^$/d' | wc -l | tr -d ' ')
  if (( ! dry )); then
    confirm_memory_budget "$planned_count" "$yes" || {
      err "メモリ予算チェックで中断しました"
      return 1
    }
  fi

  # limit 適用前に落とした分も skip 件数に含める（完了行の集計を実態と合わせるため）
  local resumed=0 skipped=$skipped_pre now
  now=$(date +%s)
  local sid cwd name opid perm label restored_name rc_name transcript win cmd_str last_epoch age_days pane_info pane_id pane_pid line sort_epoch sort_label wave_rc unregistered
  local -a claude_cmd perm_args v_entries d_entries wave_v_entries wave_d_entries f
  # 同じ会話を 2 回起動すると 1 本の会話ログに両方が書き込まれるため、実行内でも重複を弾く
  # （古いバージョンが書いた manifest や手で編集した manifest に重複が残っていることがある）
  typeset -A seen_sids
  v_entries=()
  d_entries=()
  wave_v_entries=()
  wave_d_entries=()
  local wave_failed=0 aborted=0
  while IFS=$'\t' read -r sort_epoch sort_label line; do
    [[ -z "$line" ]] && continue
    # IFS=$'\t' read は連続タブを畳んで列をずらすため使わない（無名セッション対策）
    eval 'f=("${(@ps:\t:)line}")'
    sid="${f[1]:-}"; cwd="${f[2]:-}"; name="${f[3]:-}"; opid="${f[4]:-}"; perm="${f[5]:-}"
    [[ -z "$sid" ]] && continue
    label="${name:-$sid}"

    if [[ -n "${seen_sids[$sid]:-}" ]]; then
      warn "$label: manifest 内で重複している会話です → skip（同じ会話ログへの多重書き込みを防ぐため）"
      (( skipped++ )) || true
      continue
    fi
    seen_sids[$sid]=1

    # 二重起動の判定は起動の直前に取り直す。ループ前の 1 回きりだと、波ごとの RC 待ち
    # （既定で最大 60 秒 × 波数）の間に他所で開かれた会話を見落とし、同じ会話ログに
    # 2 プロセスが書き込む
    open_ids=$(running_session_ids)
    restored_ids=$(tmux list-panes -s -t "=$TMUX_SESSION" -F '#{pane_dead}'$'\t''#{@rc_sid}' </dev/null 2>/dev/null \
      | while IFS=$'\t' read -r _dead _sid; do [[ "$_dead" == 0 && -n "$_sid" ]] && print -r -- "$_sid"; done)

    # 既にこのツールで復帰済み（tmux ウィンドウが生きている）なら二重起動しない
    if print -r -- "$restored_ids" | grep -Fqx -- "$sid"; then
      warn "$label: 既に復帰済みで tmux ウィンドウが生きています → skip"
      info "  RC が切れている場合は claude-rc-reattach reconnect を使ってください"
      (( skipped++ )) || true
      continue
    fi

    if [[ ! -d "$cwd" ]]; then
      err "$label: 作業ディレクトリが存在しません → skip ($cwd)"
      (( skipped++ )) || true
      continue
    fi

    if ! transcript=$(find_transcript "$cwd" "$sid"); then
      err "$label: 会話ログが見つかりません → skip (~/.claude/projects/*/$sid.jsonl)"
      (( skipped++ )) || true
      continue
    fi

    # 最終チャットの古さ。save の対象は「実行中かつ RC 接続中」の会話だけなので、
    # 既定では古くても捨てず、一言添えるだけにする。
    # CLAUDE_RC_MAX_AGE_DAYS に 1 以上を指定したときだけ skip する
    last_epoch=$(transcript_last_epoch "$transcript")
    (( age_days = (now - last_epoch) / 86400 )) || true
    if (( MAX_AGE_DAYS > 0 && now - last_epoch > MAX_AGE_DAYS * 86400 )); then
      warn "$label: 最終チャットが ${age_days} 日前（上限 ${MAX_AGE_DAYS} 日）→ skip"
      (( skipped++ )) || true
      continue
    fi
    (( age_days >= 3 )) && info "$label: 最終チャットは ${age_days} 日前です（そのまま復帰します）"

    # 既に動いている会話は既定で触らない（restore の複数回実行で同じ会話が二重に増えるため）
    if (( ! force )) && print -r -- "$open_ids" | grep -Fqx -- "$sid"; then
      info "skip (already running): $label"
      (( skipped++ )) || true
      continue
    fi

    # manifest に記録された権限モード（save 時の元プロセスの起動引数）を引き継ぐ。
    # ただし bypass 系は既定で引き継がない: 検出は ps の起動引数を空白分割して行うため、
    # --append-system-prompt の値に同じ語が入っていると誤検出し得る。誤って別アカウントの
    # リモート操作可能なセッションに bypass が付くのは影響が大きいので opt-in にする
    perm_args=()
    if [[ -n "$perm" ]] && (( inherit_perms && ! perm_override )); then
      eval 'perm_args=(${(z)perm})'
      if (( ! inherit_bypass )) && [[ "$perm" == *--dangerously-skip-permissions* || "$perm" == *bypassPermissions* ]]; then
        perm_args=(${perm_args:#--dangerously-skip-permissions})
        perm_args=(${perm_args:#--allow-dangerously-skip-permissions})
        perm_args=(${perm_args:#--permission-mode=bypassPermissions})
        # "--permission-mode bypassPermissions" の 2 語形式も取り除く
        local -a filtered
        filtered=()
        local j=1
        while (( j <= ${#perm_args} )); do
          if [[ "${perm_args[j]}" == --permission-mode && "${perm_args[j+1]:-}" == bypassPermissions ]]; then
            (( j += 2 )); continue
          fi
          filtered+=("${perm_args[j]}")
          (( j++ ))
        done
        perm_args=("${filtered[@]}")
        warn "$label: bypass 系の権限モードは引き継ぎません（引き継ぐ場合は --inherit-bypass）"
      fi
      (( ${#perm_args} )) && info "$label: 権限モードを引き継ぎます（${perm_args[*]}）"
    fi

    restored_name=""
    (( rename )) && restored_name=$(restored_session_name "$label" "$transcript" "$cwd")
    claude_cmd=(claude --resume "$sid" "${perm_args[@]}" "${claude_extra[@]}")
    (( name_ok && rename )) && claude_cmd+=(-n "$restored_name")
    if print -r -- "$open_ids" | grep -Fqx -- "$sid"; then
      if (( fork )); then
        claude_cmd+=(--fork-session)
        info "$label: 元のプロセスが開いたままのため --fork-session で複製として復帰します"
      else
        err "$label: この会話は別プロセスで開いたままです → skip（--force --no-fork 指定のため。複製復帰でよければ --no-fork を外して実行）"
        (( skipped++ )) || true
        continue
      fi
    fi
    # --remote-control は値を省略できる形式のため、後続の引数を名前と誤解されないよう最後に置く。
    # 会話名があれば claude.ai/code のセッション名として渡す（- で始まる名前は値として渡さない）
    if (( rc_flag )); then
      rc_name="${restored_name:-$name}"
      if [[ -n "$rc_name" && "$rc_name" != -* ]]; then
        claude_cmd+=(--remote-control "$rc_name")
      else
        claude_cmd+=(--remote-control)
      fi
    fi

    win=$(tmux_window_name "$label" "$sid")

    # tmux はコマンドをシェル文字列として受け取り sh -c で実行するため、
    # 各引数を個別にクォートしておく（スペースを含む CLAUDE_RC_CLAUDE_ARGS が分裂するのを防ぐ）
    eval 'cmd_str="${(j: :)${(q-)claude_cmd[@]}}"'

    if (( dry )); then
      ok "[dry-run] $label: tmux '$TMUX_SESSION' で実行 → $cmd_str @ $cwd"
      (( resumed++ )) || true
      continue
    fi

    # 同時起動を避けて起動間隔を空ける（credential の同時発行・同時失効を緩和するため）
    (( ${#v_entries} > 0 && STAGGER_SECS > 0 )) && sleep "$STAGGER_SECS"

    if ! pane_info=$(launch_pane "$label" "$win" "$cwd" "$cmd_str" "$sid"); then
      (( skipped++ )) || true
      continue
    fi
    pane_id="${pane_info%%$'\t'*}"
    pane_pid="${pane_info#*$'\t'}"
    v_entries+=("${pane_pid}"$'\t'"$label")
    d_entries+=("${pane_id}"$'\t'"$label")
    wave_v_entries+=("${pane_pid}"$'\t'"$label")
    wave_d_entries+=("${pane_id}"$'\t'"$label")
    ok "$label: 起動しました（tmux window: $win）"
    (( resumed++ )) || true
    if (( VERIFY_TIMEOUT > 0 && wave_size > 0 && ${#wave_v_entries} >= wave_size )); then
      print
      print -- "── RC 登録の確認（波 ${#wave_v_entries} 件 / 最大 ${VERIFY_TIMEOUT} 秒待機） ──"
      CONFIRM_DIALOG_ENTRIES=("${wave_d_entries[@]}")
      wait_rc_registration "$VERIFY_TIMEOUT" "${wave_v_entries[@]}"
      wave_rc=$?
      CONFIRM_DIALOG_ENTRIES=()
      if (( wave_rc != 0 )); then
        unregistered=$(count_unregistered_entries "${wave_v_entries[@]}")
        if confirm_wave_continue "$unregistered" "$yes"; then
          wave_failed=1
        else
          aborted=1
          break
        fi
      fi
      wave_v_entries=()
      wave_d_entries=()
    fi
  done <<< "$limited_rows"

  if (( aborted )); then
    print
    err "波状起動を中断しました"
    report_limit_remainder "$remainder_rows" restore
    return 1
  fi

  print
  ok "完了: 起動 $resumed 件 / skip $skipped 件"

  # 終了コード: 0=全件成功 / 2=部分成功（skip あり）/ 1=1 件も起動できなかった・RC 登録に失敗
  local rc=0
  (( skipped > 0 )) && rc=2
  if (( resumed == 0 )); then
    if (( skipped == 0 )); then
      warn "manifest に復帰対象の会話がありません（save は実行済みですか）"
    fi
    report_limit_remainder "$remainder_rows" restore
    return 1
  fi
  if (( dry )); then
    report_limit_remainder "$remainder_rows" restore
    return $rc
  fi

  # 起動成功 ≠ RC 登録成功。RC 登録は resume 後に非同期で行われ、credential の問題で
  # 失敗・切断されることがあるため、状態ファイルの bridgeSessionId で実測確認する
  if (( VERIFY_TIMEOUT > 0 )); then
    print
    if (( wave_size > 0 )); then
      if (( ${#wave_v_entries} > 0 )); then
        print -- "── RC 登録の確認（波 ${#wave_v_entries} 件 / 最大 ${VERIFY_TIMEOUT} 秒待機） ──"
        CONFIRM_DIALOG_ENTRIES=("${wave_d_entries[@]}")
        wait_rc_registration "$VERIFY_TIMEOUT" "${wave_v_entries[@]}"
        wave_rc=$?
        CONFIRM_DIALOG_ENTRIES=()
        if (( wave_rc != 0 )); then
          unregistered=$(count_unregistered_entries "${wave_v_entries[@]}")
          if confirm_wave_continue "$unregistered" "$yes"; then
            wave_failed=1
          else
            err "波状起動を中断しました"
            report_limit_remainder "$remainder_rows" restore
            return 1
          fi
        fi
      fi
      if (( wave_failed )); then
        warn "RC 未登録の会話があります。以下で再接続を試してください:"
        info "claude-rc-reattach reconnect"
        info "（または tmux attach -t $TMUX_SESSION で該当ウィンドウを開き、手動で /remote-control を実行）"
        report_confirm_pending
        rc=1
      else
        ok "すべての会話の RC 登録を確認しました"
        info "claude.ai/code または モバイルアプリに新しいセッションとして表示されます"
      fi
    else
      print -- "── RC 登録の確認（最大 ${VERIFY_TIMEOUT} 秒待機） ──"
      CONFIRM_DIALOG_ENTRIES=("${d_entries[@]}")
      if wait_rc_registration "$VERIFY_TIMEOUT" "${v_entries[@]}"; then
        print
        ok "すべての会話の RC 登録を確認しました"
        info "claude.ai/code または モバイルアプリに新しいセッションとして表示されます"
      else
        print
        warn "RC 未登録の会話があります。以下で再接続を試してください:"
        info "claude-rc-reattach reconnect"
        info "（または tmux attach -t $TMUX_SESSION で該当ウィンドウを開き、手動で /remote-control を実行）"
        report_confirm_pending
        rc=1
      fi
      CONFIRM_DIALOG_ENTRIES=()
    fi
  else
    print
    info "確認方法:"
    info "  tmux attach -t $TMUX_SESSION     # 各ウィンドウのフッターに /rc active が出ていれば成功"
    info "  claude.ai/code または モバイルアプリに新しいセッションとして表示されます"
  fi

  # 切り替え前の履歴はリモートに送られない（Claude Code のクロスアカウント抑止）。
  # ローカルの会話は継続しているので、期待とのズレを必ず伝える
  print
  info "※ リモート側には切り替え前の履歴は表示されません（Claude Code の仕様。ローカルの会話は継続しています）"
  if (( recap )); then
    send_recap "${v_entries[@]}" || true
  else
    info "  --no-recap 指定のため、要約送信は行いません"
  fi
  report_limit_remainder "$remainder_rows" restore
  return $rc
}

# manifest 無しで復旧するモード（save する前にクラッシュ／強制終了した場合の受け皿）
#   ~/.claude/projects/ の会話ログから「直近に更新された & いま動いていない」ものを拾って resume する
cmd_recover() {
  local dry=0 auto_confirm=0 rename=1 recap=1 hours="$RECOVER_HOURS" yes=0 limit="$MAX_SESSIONS" pick=0 wave_size="$WAVE_SIZE"
  RESUME_MODE="as-is"
  while (( $# )); do
    case "$1" in
      --within)
        shift
        if [[ ! "${1:-}" =~ ^[0-9]+$ ]]; then
          err "--within には時間（数値）を指定してください"
          return 1
        fi
        hours="$1" ;;
      --dry-run)      dry=1 ;;
      --yes)          yes=1 ;;
      --recap)        recap=1 ;;
      --no-recap)     recap=0 ;;
      --pick)         pick=1 ;;
      --auto-confirm) auto_confirm=1 ;;
      --no-rename)    rename=0 ;;
      --limit)
        shift
        if [[ ! "${1:-}" =~ ^[0-9]+$ ]]; then
          err "--limit には件数（数値）を指定してください"
          return 1
        fi
        limit="$1" ;;
      --limit=*)
        limit="${1#--limit=}"
        if [[ ! "$limit" =~ ^[0-9]+$ ]]; then
          err "--limit には件数（数値）を指定してください"
          return 1
        fi ;;
      --wave-size)
        shift
        if [[ ! "${1:-}" =~ ^[0-9]+$ ]]; then
          err "--wave-size には件数（数値）を指定してください"
          return 1
        fi
        wave_size="$1" ;;
      --wave-size=*)
        wave_size="${1#--wave-size=}"
        if [[ ! "$wave_size" =~ ^[0-9]+$ ]]; then
          err "--wave-size には件数（数値）を指定してください"
          return 1
        fi ;;
      --resume-mode)
        shift
        case "${1:-}" in
          as-is|summary) RESUME_MODE="$1" ;;
          *) err "--resume-mode は as-is または summary を指定してください"; return 1 ;;
        esac ;;
      --resume-mode=*)
        case "${1#--resume-mode=}" in
          as-is|summary) RESUME_MODE="${1#--resume-mode=}" ;;
          *) err "--resume-mode は as-is または summary を指定してください"; return 1 ;;
        esac ;;
      *) err "不明なオプション: $1"; return 1 ;;
    esac
    shift
  done
  need python3
  need claude
  (( dry )) || need_tmux || return 1

  # RC 登録待ちループ中のダイアログ処理にも --auto-confirm の指定を渡す
  CONFIRM_AUTO=$auto_confirm

  local rows
  local -a running_ids
  eval 'running_ids=(${(f)"$(running_session_ids)"})'
  rows=$(scan_recoverable "$hours" "${running_ids[@]}")
  if [[ -z "$rows" ]]; then
    info "直近 ${hours} 時間以内に更新された、いま動いていない会話はありません"
    return 0
  fi
  local indexed_rows limited_rows remainder_rows planned_count
  indexed_rows=$(print -r -- "$rows" | awk -F '\t' '{ label = ($5 != "" ? $5 : $2); print NR "\t" label "\t" $0 }')
  if (( limit > 0 )); then
    limited_rows=$(print -r -- "$indexed_rows" | awk -F '\t' -v limit="$limit" 'BEGIN { OFS = FS } NR <= limit { print $3, $4, $5, $6, $7 }')
    remainder_rows=$(print -r -- "$indexed_rows" | awk -F '\t' -v limit="$limit" 'NR > limit')
  else
    limited_rows="$rows"
    remainder_rows=""
  fi
  if (( pick )); then
    limited_rows=$(pick_rows recover "$limited_rows") || return 1
  fi
  planned_count=$(print -r -- "$limited_rows" | sed '/^$/d' | wc -l | tr -d ' ')
  if (( ! dry )); then
    confirm_memory_budget "$planned_count" "$yes" || {
      err "メモリ予算チェックで中断しました"
      return 1
    }
  fi

  # 復帰セッションに名前を付けられるか（claude のバージョンによっては -n が無い）
  local name_ok=0
  if (( rename )); then
    if claude_supports_name; then
      name_ok=1
    else
      info "この claude は -n（セッション名）に未対応のため、名前を付けずに起動します"
    fi
  fi

  # CLAUDE_RC_CLAUDE_ARGS: claude コマンドに追加するオプション（restore と同じ扱い）
  # (z) でシェルと同じ規則に分割し、(Q) で引数を囲むクォートを外す
  local -a claude_extra
  eval 'claude_extra=(${(Q)${(z)${CLAUDE_RC_CLAUDE_ARGS:-}}})'
  (( ${#claude_extra} )) && info "claude 追加オプション: ${claude_extra[*]}"

  # RC は起動時に明示する。settings.json の remoteControlAtStartup 頼みだと、
  # 設定が無い / 効いていない環境では波ごとに VERIFY_TIMEOUT 秒待たされ、
  # 最後は ⚠ + reconnect 送りになり recap も 1 通も飛ばない（restore と同じ理由）。
  # 環境変数側で既に指定されている場合は二重指定しない
  local rc_flag=1
  [[ "${claude_extra[*]}" == *--remote-control* ]] && rc_flag=0

  print -- "復旧候補（直近 ${hours} 時間・実行中のものを除く）:"
  # 注意: zsh ではループ内で `local` を再宣言すると変数の中身が出力されるため、
  # ループで使う変数はここでまとめて宣言する
  local when sid cwd proj title label win cmd_str pane_info pane_id pane_pid last_proj="" transcript wave_rc unregistered
  local restored_name rc_name
  local recovered=0 skipped=0
  local -a claude_cmd v_entries d_entries wave_v_entries wave_d_entries
  v_entries=()
  d_entries=()
  wave_v_entries=()
  wave_d_entries=()
  local wave_failed=0 aborted=0
  while IFS=$'\t' read -r when sid cwd proj title; do
    [[ -z "$sid" ]] && continue
    label="${title:-$sid}"

    if [[ "$proj" != "$last_proj" ]]; then
      print -- "[${cwd:-$proj}]"
      last_proj="$proj"
    fi

    # cwd は会話ログの先頭から拾う。取れない／消えている場合は起動先が決まらないので skip
    if [[ -z "$cwd" || ! -d "$cwd" ]]; then
      err "$label: 作業ディレクトリを特定できません → skip (${cwd:-不明})"
      (( skipped++ )) || true
      continue
    fi

    transcript=$(find_transcript "$cwd" "$sid" 2>/dev/null) || transcript=""
    claude_cmd=(claude --resume "$sid" "${claude_extra[@]}")
    restored_name=""
    if (( name_ok )); then
      restored_name=$(restored_session_name "$label" "$transcript" "$cwd")
      claude_cmd+=(-n "$restored_name")
    fi
    # --remote-control は値を省略できる形式のため、後続の引数を名前と誤解されないよう最後に置く
    if (( rc_flag )); then
      rc_name="${restored_name:-$label}"
      if [[ -n "$rc_name" && "$rc_name" != -* ]]; then
        claude_cmd+=(--remote-control "$rc_name")
      else
        claude_cmd+=(--remote-control)
      fi
    fi

    win=$(tmux_window_name "$label" "$sid")

    # tmux はコマンドをシェル文字列として受け取り sh -c で実行するため、各引数を個別にクォートする
    eval 'cmd_str="${(j: :)${(q-)claude_cmd[@]}}"'

    if (( dry )); then
      ok "[dry-run] $when  $sid  ${title:-(タイトル不明)}"
      info "  → $cmd_str"
      (( recovered++ )) || true
      continue
    fi

    # 同時起動を避けて起動間隔を空ける（credential の同時発行・同時失効を緩和するため）
    (( ${#v_entries} > 0 && STAGGER_SECS > 0 )) && sleep "$STAGGER_SECS"

    if ! pane_info=$(launch_pane "$label" "$win" "$cwd" "$cmd_str" "$sid"); then
      (( skipped++ )) || true
      continue
    fi
    pane_id="${pane_info%%$'\t'*}"
    pane_pid="${pane_info#*$'\t'}"
    v_entries+=("${pane_pid}"$'\t'"$label")
    d_entries+=("${pane_id}"$'\t'"$label")
    wave_v_entries+=("${pane_pid}"$'\t'"$label")
    wave_d_entries+=("${pane_id}"$'\t'"$label")
    ok "$label: 起動しました（tmux window: $win）"
    (( recovered++ )) || true
    if (( VERIFY_TIMEOUT > 0 && wave_size > 0 && ${#wave_v_entries} >= wave_size )); then
      sleep "$CONFIRM_WAIT"
      handle_confirm_dialogs "$auto_confirm" "$RESUME_MODE" "${wave_d_entries[@]}"
      if (( CONFIRM_PENDING > 0 )); then
        warn "${CONFIRM_PENDING} 個のセッションが確認ダイアログ待ちです"
      fi
      print
      print -- "── RC 登録の確認（波 ${#wave_v_entries} 件 / 最大 ${VERIFY_TIMEOUT} 秒待機） ──"
      CONFIRM_DIALOG_ENTRIES=("${wave_d_entries[@]}")
      wait_rc_registration "$VERIFY_TIMEOUT" "${wave_v_entries[@]}"
      wave_rc=$?
      CONFIRM_DIALOG_ENTRIES=()
      if (( wave_rc != 0 )); then
        unregistered=$(count_unregistered_entries "${wave_v_entries[@]}")
        if confirm_wave_continue "$unregistered" "$yes"; then
          wave_failed=1
        else
          aborted=1
          break
        fi
      fi
      wave_v_entries=()
      wave_d_entries=()
    fi
  done <<< "$limited_rows"

  if (( aborted )); then
    print
    err "波状起動を中断しました"
    report_limit_remainder "$remainder_rows" recover
    return 1
  fi

  print
  if (( dry )); then
    ok "候補 $recovered 件 / skip $skipped 件（--dry-run のため起動していません）"
    report_limit_remainder "$remainder_rows" recover
    return 0
  fi
  ok "完了: 起動 $recovered 件 / skip $skipped 件"
  if (( recovered == 0 )); then
    report_limit_remainder "$remainder_rows" recover
    return 0
  fi

  # restore と違い trust ダイアログや「Resume from summary」で止まることがある
  # （manifest 経由でないぶん、最後に開いた状態が読めないため）
  #   ここで return してしまうと、既に RC 接続できている他のセッションまで
  #   RC 登録確認と recap を丸ごと落とす（1 件のダイアログ待ちで全件が要約なしになる）。
  #   ダイアログ待ちは終了コードにだけ反映し、処理は最後まで進める
  local rc=0
  if (( wave_size == 0 || VERIFY_TIMEOUT == 0 || ${#wave_d_entries} > 0 )); then
    sleep "$CONFIRM_WAIT"
    if (( wave_size > 0 && VERIFY_TIMEOUT > 0 )); then
      handle_confirm_dialogs "$auto_confirm" "$RESUME_MODE" "${wave_d_entries[@]}"
    else
      handle_confirm_dialogs "$auto_confirm" "$RESUME_MODE" "${d_entries[@]}"
    fi
    if (( CONFIRM_PENDING > 0 )); then
      print
      warn "${CONFIRM_PENDING} 個のセッションが確認ダイアログ待ちです。--auto-confirm で自動応答できます"
      info "（または tmux attach -t $TMUX_SESSION でウィンドウを開き、手動で Enter）"
      info "ダイアログ待ち以外の会話は、このまま RC 登録確認と要約送信まで進めます"
      rc=1
    fi
  fi

  if (( VERIFY_TIMEOUT > 0 )); then
    print
    if (( wave_size > 0 )); then
      if (( ${#wave_v_entries} > 0 )); then
        print -- "── RC 登録の確認（波 ${#wave_v_entries} 件 / 最大 ${VERIFY_TIMEOUT} 秒待機） ──"
        CONFIRM_DIALOG_ENTRIES=("${wave_d_entries[@]}")
        wait_rc_registration "$VERIFY_TIMEOUT" "${wave_v_entries[@]}"
        wave_rc=$?
        CONFIRM_DIALOG_ENTRIES=()
        if (( wave_rc != 0 )); then
          unregistered=$(count_unregistered_entries "${wave_v_entries[@]}")
          if confirm_wave_continue "$unregistered" "$yes"; then
            wave_failed=1
          else
            err "波状起動を中断しました"
            report_limit_remainder "$remainder_rows" recover
            return 1
          fi
        fi
      fi
      if (( wave_failed )); then
        warn "RC 未登録の会話があります。以下で再接続を試してください:"
        info "claude-rc-reattach reconnect"
        rc=1
      elif (( rc )); then
        # 確認ダイアログ待ちが残っている（rc=1）状態で「すべて確認しました」とは言わない
        warn "確認ダイアログ待ちの会話を除き、RC 登録を確認しました"
      else
        ok "すべての会話の RC 登録を確認しました"
        info "claude.ai/code または モバイルアプリに新しいセッションとして表示されます"
      fi
    else
      print -- "── RC 登録の確認（最大 ${VERIFY_TIMEOUT} 秒待機） ──"
      CONFIRM_DIALOG_ENTRIES=("${d_entries[@]}")
      if wait_rc_registration "$VERIFY_TIMEOUT" "${v_entries[@]}"; then
        print
        if (( rc )); then
          warn "確認ダイアログ待ちの会話を除き、RC 登録を確認しました"
        else
          ok "すべての会話の RC 登録を確認しました"
          info "claude.ai/code または モバイルアプリに新しいセッションとして表示されます"
        fi
      else
        print
        warn "RC 未登録の会話があります。以下で再接続を試してください:"
        info "claude-rc-reattach reconnect"
        CONFIRM_DIALOG_ENTRIES=()
        rc=1
      fi
      CONFIRM_DIALOG_ENTRIES=()
    fi
    print
    info "※ リモート側には復旧前の履歴が表示されないことがあります（ローカルの会話は継続しています）"
    if (( recap )); then
      send_recap "${v_entries[@]}" || true
    else
      info "  --no-recap 指定のため、要約送信は行いません"
    fi
    report_limit_remainder "$remainder_rows" recover
    return $rc
  else
    print
    info "確認方法:"
    info "  tmux attach -t $TMUX_SESSION     # 各ウィンドウのフッターに /rc active が出ていれば成功"
    info "  --no-recap を付けていない場合も、RC 登録確認を無効化しているため要約は自動送信しません"
    report_limit_remainder "$remainder_rows" recover
    return $rc
  fi
}

# tmux の復元セッション内で、会話ログの最終更新が古い pane を閉じる
cmd_prune() {
  local idle=120 dry=0 yes=0
  while (( $# )); do
    case "$1" in
      --idle)
        shift
        if [[ ! "${1:-}" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
          err "--idle には時間（h、数値）を指定してください"
          return 1
        fi
        idle="$1" ;;
      --idle=*)
        idle="${1#--idle=}"
        if [[ ! "$idle" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
          err "--idle には時間（h、数値）を指定してください"
          return 1
        fi ;;
      --dry-run) dry=1 ;;
      --yes) yes=1 ;;
      *) err "不明なオプション: $1"; return 1 ;;
    esac
    shift
  done
  need python3
  need_tmux || return 1

  if ! tmux has-session -t "=$TMUX_SESSION" 2>/dev/null; then
    err "tmux セッション '$TMUX_SESSION' がありません（restore / recover で起動した復元セッションだけが対象です）"
    return 1
  fi

  local rows candidates count ans
  rows=$(tmux list-panes -s -t "=$TMUX_SESSION" -F '#{pane_id}'$'\t''#{pane_pid}'$'\t''#{pane_dead}'$'\t''#{window_id}'$'\t''#{window_name}'$'\t''#{@rc_sid}' 2>/dev/null)
  if [[ -z "$rows" ]]; then
    info "tmux セッション '$TMUX_SESSION' に pane がありません"
    return 0
  fi

  candidates=$(PANE_ROWS="$rows" python3 - "$SESSIONS_DIR" "$PROJECTS_DIR" "$idle" <<'PY'
import glob, json, os, re, subprocess, sys, time
from datetime import datetime

sessions_dir, projects_dir, idle_h = sys.argv[1], sys.argv[2], float(sys.argv[3])
cutoff = time.time() - idle_h * 3600
resume_re = re.compile(r"(?:--resume|-r)(?:=|\s+)([0-9a-fA-F-]{36})")

panes = []
for line in os.environ.get("PANE_ROWS", "").splitlines():
    parts = line.split("\t")
    if len(parts) < 6:
        continue
    pane_id, pane_pid, pane_dead, win_id, win_name, rc_sid = parts[:6]
    try:
        pane_pid_i = int(pane_pid)
    except ValueError:
        continue
    if pane_dead == "1":
        continue
    panes.append({
        "pane_id": pane_id,
        "pane_pid": pane_pid_i,
        "win_id": win_id,
        "win_name": win_name,
        "rc_sid": rc_sid.strip(),
    })

parent, args_of = {}, {}
try:
    raw = subprocess.run(["ps", "-ax", "-o", "pid=,ppid=,args="], capture_output=True, text=True).stdout
except Exception:
    raw = ""
for line in raw.splitlines():
    parts = line.split(None, 2)
    if len(parts) < 3:
        continue
    try:
        pid, ppid = int(parts[0]), int(parts[1])
    except ValueError:
        continue
    parent[pid] = ppid
    args_of[pid] = parts[2]

def ancestor_depth(pid, target, limit=8):
    depth = 0
    while depth <= limit:
        if pid == target:
            return depth
        if pid not in parent:
            return None
        pid = parent[pid]
        depth += 1
    return None

states = []
for path in sorted(glob.glob(os.path.join(sessions_dir, "*.json"))):
    try:
        d = json.load(open(path))
    except Exception:
        continue
    if d.get("kind") != "interactive":
        continue
    pid = d.get("pid")
    sid = d.get("sessionId")
    if not isinstance(pid, int) or not sid:
        continue
    if pid not in parent or "claude" not in args_of.get(pid, "").lower():
        continue
    states.append((pid, sid, d.get("cwd") or "", d.get("name") or ""))

def transcript_for(sid):
    hits = glob.glob(os.path.join(projects_dir, "*", f"{sid}.jsonl"))
    if not hits:
        return ""
    return max(hits, key=lambda p: os.path.getmtime(p))

def sid_from_process_args(pane_pid):
    best = None
    for pid, args in args_of.items():
        depth = ancestor_depth(pid, pane_pid)
        if depth is None:
            continue
        if "claude" not in args.lower():
            continue
        match = resume_re.search(args)
        if not match:
            continue
        cand = (depth, match.group(1))
        if best is None or cand[0] < best[0]:
            best = cand
    return best[1] if best else ""

def state_for_pane(pane_pid):
    best = None
    for pid, sid, cwd, name in states:
        depth = ancestor_depth(pid, pane_pid)
        if depth is None:
            continue
        cand = (depth, sid, cwd, name)
        if best is None or cand[0] < best[0]:
            best = cand
    return best

for pane in panes:
    st = state_for_pane(pane["pane_pid"])
    # いま動いている claude 本人の sessionId を最優先する。
    # @rc_sid は復元元の sessionId なので、--fork-session で復帰した pane では
    # 別物になり、その会話ログは fork 時点で更新が止まる。@rc_sid を優先すると
    # 「使用中の pane を idle と判定して閉じる」事故になる
    sid = (st[1] if st else "") or pane["rc_sid"] or sid_from_process_args(pane["pane_pid"])
    if not sid:
        continue
    label = (st[3] if st and st[3] else "") or pane["win_name"] or sid
    transcript = transcript_for(sid)
    if not transcript:
        continue
    try:
        mtime = os.path.getmtime(transcript)
    except OSError:
        continue
    if mtime >= cutoff:
        continue
    age_h = int((time.time() - mtime) / 3600)
    when = datetime.fromtimestamp(mtime).strftime("%Y-%m-%d %H:%M")
    print("\t".join([
        str(int(mtime)),
        when,
        str(age_h),
        pane["pane_id"],
        pane["win_id"],
        pane["win_name"],
        sid,
        transcript,
        label.replace("\t", " ").replace("\n", " "),
    ]))
PY
)

  count=$(print -r -- "$candidates" | sed '/^$/d' | wc -l | tr -d ' ')
  if (( count == 0 )); then
    ok "店じまい対象はありません（idle ${idle}h より古い復元paneなし）"
    return 0
  fi

  print -- "店じまい候補（idle ${idle}h より古い会話ログ）:"
  print -r -- "$candidates" | sort -n -t $'\t' -k1,1 | while IFS=$'\t' read -r _mtime when age_h pane_id _win_id win_name sid _transcript label; do
    info "• ${label:-$win_name}  pane=$pane_id  最終更新=$when（${age_h}h前）  session=$sid"
  done

  if (( dry )); then
    ok "${count}件を店じまいします（dry-run のため終了処理はしません）"
    return 0
  fi

  if (( yes )); then
    print -- "${count}件を店じまいします(会話の記録は残り、いつでも restore/recover で戻せます)"
  else
    printf "%s件を店じまいします(会話の記録は残り、いつでも restore/recover で戻せます)。続行しますか? [y/N]: " "$count"
    read -r ans || ans=""
    [[ "$ans" == [yY]* ]] || { warn "中止しました"; return 1; }
  fi

  local closed=0 killed=0 pane_id win_id win_name label sid _mtime when age_h _transcript pane_out
  print -r -- "$candidates" | sort -n -t $'\t' -k1,1 | while IFS=$'\t' read -r _mtime when age_h pane_id win_id win_name sid _transcript label; do
    if ! tmux display-message -p -t "$pane_id" '#{pane_id}' >/dev/null 2>&1; then
      continue
    fi
    # 確認ダイアログ待ちの pane には触らない。
    # ダイアログで止まった pane は会話が 1 行も進まないため会話ログの mtime が古いままで、
    # prune 候補の上位に来る。そこへ C-c → "/exit" → Enter を送ると、C-c で TUI が
    # 終わらなかった場合に最後の Enter が既定選択の確定として解釈され、
    # restore / recover が人間の判断に返したはずの trust 承認が prune 経由で通ってしまう
    # （実測: C-c では claude は終了せず "/exit" はダイアログに吸われる）
    pane_out=$(tmux capture-pane -p -t "$pane_id" 2>/dev/null) || pane_out=""
    if [[ "$pane_out" == *"Yes, I trust"* || "$pane_out" == *"Enter to confirm"* \
       || "$pane_out" == *"Resume full session as-is"* ]]; then
      warn "${label:-$win_name}: 確認ダイアログ待ちのため店じまいしません（tmux attach -t $TMUX_SESSION で応答してください）"
      continue
    fi
    tmux send-keys -t "$pane_id" C-c 2>/dev/null || true
    sleep 0.2
    tmux send-keys -t "$pane_id" -l -- "/exit" 2>/dev/null || true
    sleep 0.2
    tmux send-keys -t "$pane_id" Enter 2>/dev/null || true
    sleep 5
    if tmux display-message -p -t "$pane_id" '#{pane_id}' >/dev/null 2>&1; then
      # kill-window は pane ターゲットを渡してもウィンドウ全体を落とすため、
      # ユーザーが Ctrl-b " で分割して下段で回している作業（build / tail /
      # レンダリング等）まで巻き添えで殺してしまう。対象の pane だけを閉じる
      # （そのウィンドウに他の pane が無ければ結果的にウィンドウも閉じる）
      tmux kill-pane -t "$pane_id" 2>/dev/null || true
      ok "${label:-$win_name}: /exit 後も残っていたため tmux pane を閉じました"
      (( killed++ )) || true
    else
      ok "${label:-$win_name}: 正常終了しました"
      (( closed++ )) || true
    fi
  done
  ok "完了: 正常終了 $closed 件 / kill-pane $killed 件"
}

# restore 後に RC が未登録・切断状態になったセッションへ /remote-control を送って再接続する
#   対象は tmux セッション "$TMUX_SESSION" 内の pane のみ（通常のターミナルにはキーを送れない）
cmd_reconnect() {
  local recap=0
  while (( $# )); do
    case "$1" in
      --recap) recap=1 ;;
      *) err "不明なオプション: $1"; return 1 ;;
    esac
    shift
  done
  need python3
  need_tmux || return 1

  if ! tmux has-session -t "=$TMUX_SESSION" 2>/dev/null; then
    err "tmux セッション '$TMUX_SESSION' がありません（restore で起動したセッションが対象です）"
    return 1
  fi

  # 対象は restore が作った pane（@rc_sid 付き）だけに限る。
  # 同名の tmux セッションに手で作った pane や無関係なシェルへキーを送らないため
  local rows
  # 区切りはタブにする。スペース区切りだと @rc_sid が空の pane（＝restore 以外が作った pane）で
  # 列が詰まり、window_name が pane_sid に入って「restore が作った pane」と誤判定される
  rows=$(tmux list-panes -s -t "=$TMUX_SESSION" -F '#{pane_pid}'$'\t''#{pane_dead}'$'\t''#{pane_id}'$'\t''#{@rc_sid}'$'\t''#{window_name}')
  if [[ -z "$rows" ]]; then
    err "tmux セッション '$TMUX_SESSION' に pane がありません"
    return 1
  fi

  typeset -A id_of win_of
  local -a live_pids target_entries pf
  local pane_pid pane_dead pane_id pane_sid win_name line st sid n_connected=0 n_missing=0 n_dead=0 n_foreign=0 sent=0 rc=0
  live_pids=()
  target_entries=()
  # IFS=$'\t' read はタブも「IFS の空白」として連続分を畳むため、@rc_sid が空の行で
  # 列がずれる。列を保つために (@ps:\t:) で明示的に分割する
  print -r -- "$rows" | while IFS= read -r line; do
    eval 'pf=("${(@ps:\t:)line}")'
    pane_pid="${pf[1]:-}"; pane_dead="${pf[2]:-}"; pane_id="${pf[3]:-}"
    pane_sid="${pf[4]:-}"; win_name="${pf[5]:-}"
    [[ -z "$pane_pid" ]] && continue
    if [[ -z "$pane_sid" ]]; then
      # restore 以外が作った pane（v1.6 以前の restore で作った pane もここに入る）
      (( n_foreign++ )) || true
      continue
    fi
    if [[ "$pane_dead" == 1 ]]; then
      warn "$win_name: claude が終了しています → skip（tmux attach -t $TMUX_SESSION で pane のエラーを確認）"
      (( n_dead++ )) || true
      continue
    fi
    live_pids+=("$pane_pid")
    id_of[$pane_pid]="$pane_id"
    win_of[$pane_pid]="$win_name"
  done
  if (( n_foreign > 0 )); then
    info "restore が作ったものではない pane を $n_foreign 件 skip しました（キー送信の対象外）"
  fi
  if (( ${#live_pids} == 0 )); then
    err "生きている pane がありません"
    return 1
  fi

  print -r -- "$(pane_rc_status "${live_pids[@]}")" | while IFS=$'\t' read -r pane_pid st sid; do
    case "$st" in
      connected)
        info "${win_of[$pane_pid]}: RC 接続済み → skip"
        (( n_connected++ )) || true ;;
      pending)
        # composer に /remote-control を打ち込んで実行させる。
        # 入力とEnterを分けて送り、TUI がスラッシュコマンドを認識する時間を確保する
        tmux send-keys -t "${id_of[$pane_pid]}" -- '/remote-control'
        sleep 0.5
        tmux send-keys -t "${id_of[$pane_pid]}" Enter
        ok "${win_of[$pane_pid]}: /remote-control を送信しました"
        target_entries+=("${pane_pid}"$'\t'"${win_of[$pane_pid]}")
        (( sent++ )) || true ;;
      missing)
        warn "${win_of[$pane_pid]}: claude セッションを検出できません → skip"
        (( n_missing++ )) || true ;;
    esac
  done

  # 検出不能・終了済みの pane は reconnect では対処できない失敗として数える
  # （restore が missing で reconnect を案内するため、ここで成功を装うと失敗が隠れる）
  if (( sent == 0 )); then
    print
    if (( n_missing + n_dead > 0 )); then
      warn "再接続を送信できる pane がありませんでした（接続済み $n_connected / 検出不能 $n_missing / 終了 $n_dead）"
      info "tmux attach -t $TMUX_SESSION で各 pane の状態を確認してください"
      return 1
    fi
    ok "再接続が必要な会話はありません（接続済み $n_connected 件）"
    # --recap の対象は「今回つなぎ直した会話」だけ。指定されたのに何も送らないと
    # 無視されたように見えるため、その旨を伝える
    (( recap )) && info "（--recap は再接続した会話にのみ送ります。既に接続済みの会話には送っていません）"
    return 0
  fi

  if (( VERIFY_TIMEOUT > 0 )); then
    print
    print -- "── RC 登録の確認（最大 ${VERIFY_TIMEOUT} 秒待機） ──"
    wait_rc_registration "$VERIFY_TIMEOUT" "${target_entries[@]}" || rc=1
  else
    print
    info "各ウィンドウのフッターに /rc active が出ているか確認してください（tmux attach -t $TMUX_SESSION）"
  fi
  # 再接続で作られる RC セッションにも、切り替え前の履歴は送られない
  (( recap )) && { send_recap "${target_entries[@]}" || true; }
  (( n_missing + n_dead > 0 )) && rc=1
  return $rc
}

cmd_switch() {
  local -a pass_opts
  local dry=0
  pass_opts=()
  while (( $# )); do
    case "$1" in
      --dry-run) dry=1; pass_opts+=("$1") ;;
      --fork|--no-fork|--force|--no-rename|--no-inherit-perms|--inherit-bypass|--recap|--no-recap|--yes|--pick) pass_opts+=("$1") ;;
      --limit|--resume-mode|--wave-size)
        pass_opts+=("$1")
        shift
        [[ -n "${1:-}" ]] || { err "${pass_opts[-1]} には値が必要です"; return 1; }
        pass_opts+=("$1") ;;
      --limit=*|--resume-mode=*|--wave-size=*) pass_opts+=("$1") ;;
      *) err "不明なオプション: $1"; return 1 ;;
    esac
    shift
  done
  need claude
  # tmux はステップ 4 の restore まで使わないが、logout 後に無いと気づくと
  # 手遅れ（切り替えだけ完了して復帰できない）なので先に確認する
  need_tmux || return 1

  # --dry-run では何も変更しない（manifest の上書きも logout / login もしない）。
  # 保存内容の確認だけは行いたいので、一時 manifest に書いて restore --dry-run に渡す
  if (( dry )); then
    local real_manifest="$MANIFEST" tmp_manifest rc_dry
    tmp_manifest=$(mktemp "${TMPDIR:-/tmp}/claude-rc-reattach.XXXXXX") || {
      err "一時ファイルを作成できません"; return 1
    }
    print -- "── 1/4 RC 接続中の会話を保存（dry-run） ──"
    MANIFEST="$tmp_manifest"
    if ! cmd_save; then
      MANIFEST="$real_manifest"; rm -f "$tmp_manifest"
      return 1
    fi
    info "（dry-run のため $real_manifest は変更していません）"
    print
    print -- "── 2/4 既存セッションの終了（dry-run: 確認をスキップ） ──"
    print
    print -- "── 3/4 アカウント切り替え（dry-run: logout / login は実行しません） ──"
    print
    print -- "── 4/4 会話の復帰 ──"
    cmd_restore "${pass_opts[@]}"
    rc_dry=$?
    MANIFEST="$real_manifest"
    rm -f "$tmp_manifest"
    return $rc_dry
  fi

  print -- "── 1/4 RC 接続中の会話を保存 ──"
  cmd_save || return 1

  print
  print -- "── 2/4 既存セッションの終了 ──"
  print -- "上記の会話を開いているターミナル / クライアントをすべて終了してください。"
  print -- "（開いたままの会話は複製（--fork-session）として復帰します。同一セッションとして"
  print -- "  復帰させたい場合は必ず閉じてください。複製せず skip したい場合は --no-fork）"
  local _ans manifest_sids open_left line sid cwd name pid
  local -a f
  manifest_sids=$(grep -v '^#' "$MANIFEST" | cut -f1)
  while :; do
    # read の失敗（標準入力が EOF）を無視すると、この確認ループが無限に回る
    if ! read -r "_ans?終了したら Enter（中断は Ctrl-C）: "; then
      print
      err "標準入力を読めません。switch は対話実行が前提です"
      err "（非対話で行う場合は save → 手動で切り替え → restore を個別に実行してください）"
      return 1
    fi
    # 閉じ忘れの検知: manifest に記録した会話がまだ開いたままなら列挙して確認する
    open_left=$(scan_sessions open | while IFS= read -r line; do
      eval 'f=("${(@ps:\t:)line}")'
      sid="${f[1]:-}"; cwd="${f[2]:-}"; name="${f[3]:-}"; pid="${f[4]:-}"
      [[ -z "$sid" ]] && continue
      print -r -- "$manifest_sids" | grep -Fqx -- "$sid" && print -- "  • ${name:-(無名)}  [$cwd]  pid=$pid"
    done)
    [[ -z "$open_left" ]] && break
    print
    warn "まだ開いたままの会話があります:"
    print -r -- "$open_left"
    warn "開いたまま切り替えると、元のプロセスは旧アカウントのトークン失効により RC が"
    warn "credential エラー（code 4094 / 401）で切断され、復帰は複製になります。"
    if ! read -r "_ans?それでも続行する場合は y、閉じ直して再確認する場合は Enter: "; then
      print
      err "標準入力を読めません。switch は対話実行が前提です"
      return 1
    fi
    [[ "$_ans" == [yY]* ]] && break
    print
  done

  print
  print -- "── 3/4 アカウント切り替え ──"
  # logout の失敗を無視すると、旧アカウントのまま login 画面に進んでしまう
  if ! claude auth logout; then
    err "ログアウトに失敗しました。中断します（manifest は保存済みです）"
    return 1
  fi
  print -- "新しいアカウントでログインしてください:"
  if ! claude auth login; then
    err "ログインに失敗しました。ログイン後に 'claude-rc-reattach restore' で復帰できます（manifest は保存済み）"
    return 1
  fi

  print
  print -- "── 4/4 会話の復帰 ──"
  cmd_restore "${pass_opts[@]}"
}

usage() {
  cat <<EOF
claude-rc-reattach v$VERSION
アカウント切り替え後、Remote Control 接続中だった会話を新アカウントで復帰させるツール

USAGE:
  claude-rc-reattach <command> [options]

COMMANDS:
  list               RC 接続中の会話を表示（save の対象になるもの）
  save               RC 接続中の会話を manifest に保存（切り替え「前」に実行）
  restore [options]  manifest の会話を tmux 内で resume して RC 再登録（切り替え「後」に実行）
  switch  [options]  save → logout → login → restore を一括実行
  recover [options]  manifest 無しで、直近に更新された会話ログから復旧（クラッシュ後の受け皿）
  prune [options]    復元用 tmux セッション内の古い pane を正常終了して片付ける
  reconnect [--recap] tmux 内の RC 未登録セッションに /remote-control を送信して再接続
  help               このヘルプを表示

RESTORE/SWITCH OPTIONS:
  --force              すでに動いている会話も復帰させる
                       （既定: 動いている会話は "skip (already running)" として触らない）
  --no-fork            --force 時、元プロセスが開いたままの会話を複製せず skip する
                       （既定: --fork-session で複製として復帰。元の会話は変更されない）
  --no-rename          復帰セッションに名前（<元の名前>-restored-MMDD）を付けない
  --no-inherit-perms   save 時に検出した権限モードを引き継がない（既定: 引き継ぐ）
  --inherit-bypass     bypass 系の権限モードも引き継ぐ
                       （--dangerously-skip-permissions / --permission-mode bypassPermissions。
                         既定では引き継がない。ps からの検出は誤検出し得るため）
  --recap              RC 登録できた会話に要約依頼を 1 通送る（既定）
  --no-recap           要約依頼を送らない
                       （切り替え前の履歴はリモートに送られないため、既定では要約で文脈を残す。
                         入力欄は空にしておくこと）
  --limit <N>          起動する復元候補の上限（既定: $MAX_SESSIONS。0 で無制限）
  --pick               復元候補を番号付き一覧から対話選択する
  --wave-size <N>      N 件ずつ起動して RC 登録確認後に次の波へ進む
                       （既定: $WAVE_SIZE。0 で従来どおり一括起動）
  --resume-mode <mode> Resume ダイアログの選択（as-is または summary。既定: as-is）
  --yes                メモリ予算の確認プロンプトを省略する
                       波ごとの RC 未登録確認も自動続行する
  --dry-run            実際には起動せず、何が行われるかだけ表示
                       （switch では manifest の上書きも logout / login も行わない）

EXIT STATUS (restore / switch):
  0  すべての会話を復帰し、RC 登録も確認できた
  1  1 件も復帰できなかった、または RC 登録を確認できなかった
  2  一部の会話を skip した（部分成功）

RECOVER OPTIONS:
  --within <hours>     この時間内に更新された会話ログを対象にする（既定: $RECOVER_HOURS）
  --auto-confirm       起動後の確認ダイアログ（trust / Resume from summary）に Enter を自動送信
                       （trust 確認への Enter はプロジェクト設定・権限の承認そのものなので、
                         このフラグを付けない限り自動送信せずダイアログ待ちとして報告する。
                         restore にこのフラグは無く、trust 確認は常に人間に返す）
  --recap              RC 登録できた会話に要約依頼を 1 通送る（既定）
  --no-recap           要約依頼を送らない
  --limit <N>          起動する復元候補の上限（既定: $MAX_SESSIONS。0 で無制限）
  --pick               復元候補を番号付き一覧から対話選択する
  --wave-size <N>      N 件ずつ起動して RC 登録確認後に次の波へ進む
                       （既定: $WAVE_SIZE。0 で従来どおり一括起動）
  --resume-mode <mode> Resume ダイアログの選択（as-is または summary。既定: as-is）
  --yes                メモリ予算の確認プロンプトを省略する
                       波ごとの RC 未登録確認も自動続行する
  --no-rename          復帰セッションに名前を付けない
  --dry-run            候補一覧だけ表示して起動しない

PRUNE OPTIONS:
  --idle <hours>        この時間より会話ログの最終更新が古い復元paneを対象にする（既定: 120=5日）
  --dry-run            候補一覧だけ表示して終了処理はしない
  --yes                店じまい確認を省略する

ENVIRONMENT:
  CLAUDE_RC_MANIFEST       manifest の保存先（既定: $STATE_DIR/manifest.tsv）
  CLAUDE_RC_TMUX_SESSION   復帰先の tmux セッション名（既定: rc-restore）
  CLAUDE_RC_CLAUDE_ARGS    restore / recover 時に claude コマンドへ追加するオプション
                           （例: "--dangerously-skip-permissions"）
                           権限モードを指定した場合は自動引き継ぎより優先される
  CLAUDE_RC_MAX_AGE_DAYS   最終チャットからこの日数を超えた会話を restore で skip する
                           （既定: 0 = skip しない。1 以上でその日数を上限にする）
  CLAUDE_RC_VERIFY_TIMEOUT restore / reconnect 後に RC 登録を確認する最大秒数
                           （既定: 60。0 で確認しない）
  CLAUDE_RC_STAGGER_SECS   restore で各セッションを起動する間隔の秒数
                           （既定: 3。credential の同時発行・同時失効の緩和用。0 で無効化）
  CLAUDE_RC_RECAP_PROMPT   recap で送るプロンプト（必ず 1 行で書くこと）
                           （既定: アカウント切替で画面上の履歴が空になっています。
                             これまでの会話の経緯・決定事項・いま取り組んでいる作業を
                             10行以内で要約して表示してください。）
  CLAUDE_RC_RECOVER_HOURS  recover の既定の対象時間（既定: 6。--within で上書き）
  CLAUDE_RC_CONFIRM_WAIT   recover で確認ダイアログを見に行くまでの待ち秒数（既定: 10）
  CLAUDE_RC_MAX_SESSIONS   restore / recover で起動する復元候補の既定上限（既定: 15。0 で無制限）
  CLAUDE_RC_WAVE_SIZE      restore / recover で一度に起動する件数（既定: 3。0 で一括起動）
EOF
}

case "${1:-help}" in
  list)      shift; cmd_list "$@" ;;
  save)      shift; cmd_save "$@" ;;
  restore)   shift; cmd_restore "$@" ;;
  switch)    shift; cmd_switch "$@" ;;
  recover)   shift; cmd_recover "$@" ;;
  prune)     shift; cmd_prune "$@" ;;
  reconnect) shift; cmd_reconnect "$@" ;;
  -h|--help|help) usage ;;
  -v|--version)   print -- "$VERSION" ;;
  *) err "不明なコマンド: $1"; print; usage; exit 1 ;;
esac
